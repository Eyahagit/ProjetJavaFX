{% extends 'base.html.twig' %}

{% block title %}Conseil details{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Conseils</div>
                <h1 class="h2 mb-1">Conseil #{{ conseil.id }}</h1>
                <p class="text-muted mb-0">Detailed view for this recommendation entry.</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('app_conseils_index') }}">
                    <i class="bi bi-arrow-left me-1"></i>Back to list
                </a>
                <a class="btn btn-primary" href="{{ path('app_conseils_edit', {'id': conseil.id}) }}">
                    <i class="bi bi-pencil-square me-1"></i>Edit
                </a>
                {{ include('conseils/_delete_form.html.twig', {
                    conseil: conseil,
                    button_class: 'btn btn-outline-danger',
                    button_label: 'Delete',
                    form_class: 'd-inline-block',
                    confirm_message: 'Delete this conseil?'
                }) }}
            </div>
        </div>

        <div class="card content-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table detail-table align-middle mb-0">
                        <tbody>
                            <tr>
                                <th>Id</th>
                                <td>{{ conseil.id }}</td>
                            </tr>
                            <tr>
                                <th>Type</th>
                                <td>{{ conseil.typeEtat }}</td>
                            </tr>
                            <tr>
                                <th>Level</th>
                                <td>{{ conseil.niveau ?? '--' }}</td>
                            </tr>
                            <tr>
                                <th>Advice</th>
                                <td class="text-break">{{ conseil.conseil }}</td>
                            </tr>
                            <tr>
                                <th>Category</th>
                                <td>{{ conseil.categorie ?? '--' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
