{% extends 'base.html.twig' %}

{% block title %}Edit conseil{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Conseils</div>
                <h1 class="h2 mb-1">Edit conseil #{{ conseil.id }}</h1>
                <p class="text-muted mb-0">Update wording, level, or category for this recommendation.</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('app_conseils_index') }}">
                    <i class="bi bi-arrow-left me-1"></i>Back to list
                </a>
                <a class="btn btn-outline-primary" href="{{ path('app_conseils_show', {'id': conseil.id}) }}">
                    <i class="bi bi-eye me-1"></i>View details
                </a>
                {{ include('conseils/_delete_form.html.twig', {
                    conseil: conseil,
                    button_class: 'btn btn-outline-danger',
                    button_label: 'Delete',
                    form_class: 'd-inline-block',
                    confirm_message: 'Delete this conseil?'
                }) }}
            </div>
        </div>

        <div class="card content-card">
            <div class="card-body p-4">
                {{ include('conseils/_form.html.twig', {
                    button_label: 'Save changes',
                    button_icon: 'save',
                    button_class: 'btn btn-primary'
                }) }}
            </div>
        </div>
    </div>
{% endblock %}
