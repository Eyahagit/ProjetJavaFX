{% extends 'base.html.twig' %}

{% block title %}Modifier conseil{% endblock %}

{% block body %}
    <div class="container py-4">

        <!-- HEADER -->
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Conseils</div>
                <h1 class="h2 mb-1">Modifier conseil #{{ conseil.id }}</h1>
                <p class="text-muted mb-0">Mettre à jour le contenu, le niveau ou la catégorie de cette recommandation.</p>
            </div>

            <div class="d-flex flex-wrap gap-2">

                <!-- BACK -->
                <a class="btn"
                   style="
                       border:1px solid #6B7280;
                       color:#6B7280;
                       border-radius:10px;
                   "
                   onmouseover="this.style.background='#6B7280'; this.style.color='white';"
                   onmouseout="this.style.background='transparent'; this.style.color='#6B7280';"
                   href="{{ path('app_conseils_index') }}">
                    <i class="bi bi-arrow-left me-1"></i>Retour à la liste
                </a>

                <!-- VIEW -->
                <a class="btn"
                   style="
                       border:1px solid #4CAF8E;
                       color:#4CAF8E;
                       border-radius:10px;
                   "
                   onmouseover="this.style.background='#4CAF8E'; this.style.color='white';"
                   onmouseout="this.style.background='transparent'; this.style.color='#4CAF8E';"
                   href="{{ path('app_conseils_show', {'id': conseil.id}) }}">
                    <i class="bi bi-eye me-1"></i>Voir détails
                </a>

                <!-- DELETE -->
                {{ include('conseils/_delete_form.html.twig', {
                    conseil: conseil,
                    button_class: 'btn',
                    button_label: 'Supprimer',
                    form_class: 'd-inline-block',
                    confirm_message: 'Supprimer ce conseil ?'
                }) }}

            </div>
        </div>

        <!-- FORM CARD -->
        <div class="card content-card">
            <div class="card-body p-4">

                {{ include('conseils/_form.html.twig', {
                    button_label: 'Enregistrer les modifications',
                    button_icon: 'save',
                    button_class: 'btn'
                }) }}

            </div>
        </div>
    </div>
{% endblock %}