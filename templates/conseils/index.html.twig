{% extends 'base.html.twig' %}

{% block title %}Conseils{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Conseils</div>
                <h1 class="h2 mb-1">Recommendation catalog</h1>
                <p class="text-muted mb-0">Manage advice entries used across the health tracking experience.</p>
            </div>

            <a class="btn btn-primary" href="{{ path('app_conseils_new') }}">
                <i class="bi bi-plus-lg me-1"></i>Add conseil
            </a>
        </div>

        <div class="card content-card">
            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-3 px-4">
                <div>
                    <h2 class="h5 mb-1">All conseils</h2>
                    <p class="text-muted mb-0">Structured by state, level, and category.</p>
                </div>
                <span class="badge rounded-pill text-bg-light">{{ conseils|length }} items</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Id</th>
                                <th>Type</th>
                                <th>Level</th>
                                <th>Advice</th>
                                <th>Category</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for conseil in conseils %}
                            <tr>
                                <td>{{ conseil.id }}</td>
                                <td>{{ conseil.typeEtat }}</td>
                                <td>{{ conseil.niveau ?? '--' }}</td>
                                <td>{{ conseil.conseil|length > 120 ? conseil.conseil|slice(0, 120) ~ '...' : conseil.conseil }}</td>
                                <td>{{ conseil.categorie ?? '--' }}</td>
                                <td class="text-nowrap">
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_conseils_show', {'id': conseil.id}) }}">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_conseils_edit', {'id': conseil.id}) }}">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>
                                        {{ include('conseils/_delete_form.html.twig', {
                                            conseil: conseil,
                                            button_class: 'btn btn-sm btn-outline-danger',
                                            button_label: 'Delete',
                                            form_class: 'd-inline-block',
                                            confirm_message: 'Delete this conseil?'
                                        }) }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td class="text-center py-4 empty-state" colspan="6">No conseils found.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
