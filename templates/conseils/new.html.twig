{% extends 'base.html.twig' %}

{% block title %}Nouveau conseil{% endblock %}

{% block body %}
    <div class="container py-4">

        <!-- HEADER -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Conseils</div>
                <h1 class="h2 mb-1">Créer un conseil</h1>
                <p class="text-muted mb-0">Ajouter une nouvelle recommandation pour le suivi du bien-être.</p>
            </div>

            <!-- BACK BUTTON -->
            <a class="btn"
               style="
                   border:1px solid #6B7280;
                   color:#6B7280;
                   border-radius:10px;
               "
               onmouseover="this.style.background='#6B7280'; this.style.color='white';"
               onmouseout="this.style.background='transparent'; this.style.color='#6B7280';"
               href="{{ path('app_conseils_index') }}">
                <i class="bi bi-arrow-left me-1"></i>Retour à la liste
            </a>
        </div>

        <!-- FORM CARD -->
        <div class="card content-card">
            <div class="card-body p-4">

                {{ include('conseils/_form.html.twig', {
                    button_label: 'Créer le conseil',
                    button_icon: 'plus-lg',
                    button_class: 'btn'
                }) }}

            </div>
        </div>
    </div>
{% endblock %}