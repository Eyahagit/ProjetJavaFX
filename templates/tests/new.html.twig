{% extends 'base.html.twig' %}

{% block title %}Créer un test{% endblock %}

{% block body %}
    <div class="container py-4">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="page-kicker mb-1">TESTS</div>
                <h1 class="h3">Créer un test</h1>
            </div>

            <!-- BACK BUTTON -->
            <a href="{{ path('app_tests_index') }}"
               class="btn"
               style="
                   border:1px solid #6B7280;
                   color:#6B7280;
                   border-radius:10px;
                   padding:6px 12px;
               "
               onmouseover="this.style.background='#6B7280'; this.style.color='white';"
               onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
                <i class="bi bi-arrow-left me-1"></i>Retour à la liste
            </a>
        </div>

        <!-- CARD -->
        <div class="card content-card">
            <div class="card-body p-4">

                {{ include('tests/_form.html.twig', {
                    button_label: 'Créer le test'
                }) }}

            </div>
        </div>

    </div>
{% endblock %}