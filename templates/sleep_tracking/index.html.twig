{% extends 'base.html.twig' %}

{% block title %}Sleep tracking{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Sleep tracking</div>
                <h1 class="h2 mb-1">Sleep records</h1>
                <p class="text-muted mb-0">Monitor recorded sleep sessions, duration, and quality indicators.</p>
            </div>

            <a class="btn btn-primary" href="{{ path('app_sleep_tracking_new') }}">
                <i class="bi bi-plus-lg me-1"></i>Add sleep record
            </a>
        </div>

        <div class="card content-card">
            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-3 px-4">
                <div>
                    <h2 class="h5 mb-1">All sleep sessions</h2>
                    <p class="text-muted mb-0">A responsive overview of recorded sleep behavior.</p>
                </div>
                <span class="badge rounded-pill text-bg-light">{{ sleep_trackings|length }} entries</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Id</th>
                                <th>Sleep date</th>
                                <th>Bed time</th>
                                <th>Wake time</th>
                                <th>Duration</th>
                                <th>Quality</th>
                                <th>Comment</th>
                                <th>Created at</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for sleep_tracking in sleep_trackings %}
                            <tr>
                                <td>{{ sleep_tracking.id }}</td>
                                <td>{{ sleep_tracking.dateSommeil ? sleep_tracking.dateSommeil|date('Y-m-d') : '--' }}</td>
                                <td>{{ sleep_tracking.heureCoucher ? sleep_tracking.heureCoucher|date('H:i') : '--' }}</td>
                                <td>{{ sleep_tracking.heureReveil ? sleep_tracking.heureReveil|date('H:i') : '--' }}</td>
                                <td>{{ sleep_tracking.dureeMinutes }} min</td>
                                <td>{{ sleep_tracking.qualiteSommeil }}</td>
                                <td>{{ sleep_tracking.commentaire and sleep_tracking.commentaire|length > 80 ? sleep_tracking.commentaire|slice(0, 80) ~ '...' : (sleep_tracking.commentaire ?: '--') }}</td>
                                <td>{{ sleep_tracking.dateCreation ? sleep_tracking.dateCreation|date('Y-m-d H:i') : '--' }}</td>
                                <td class="text-nowrap">
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_sleep_tracking_show', {'id': sleep_tracking.id}) }}">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_sleep_tracking_edit', {'id': sleep_tracking.id}) }}">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>
                                        {{ include('sleep_tracking/_delete_form.html.twig', {
                                            sleep_tracking: sleep_tracking,
                                            button_class: 'btn btn-sm btn-outline-danger',
                                            button_label: 'Delete',
                                            form_class: 'd-inline-block',
                                            confirm_message: 'Delete this sleep tracking entry?'
                                        }) }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td class="text-center py-4 empty-state" colspan="9">No sleep records found.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
