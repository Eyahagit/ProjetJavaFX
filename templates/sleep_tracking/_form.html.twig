{{ form_start(form, {'attr': {'class': 'crud-form'}}) }}

    {{ form_widget(form) }}

<div class="d-flex flex-wrap justify-content-end gap-2 mt-4">

    <button
            class="{{ button_class|default('btn') }}"
            style="
                background:#4CAF8E;
                color:white;
                border-radius:10px;
                padding:8px 16px;
                border:none;
            "
            onmouseover="this.style.background='#2F7D6D';"
            onmouseout="this.style.background='#4CAF8E';"
    >
        <i class="bi bi-{{ button_icon|default('check2-circle') }} me-1"></i>
        {{ button_label|default('Enregistrer') }}
    </button>

</div>

{{ form_end(form) }}