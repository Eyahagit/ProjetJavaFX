{% extends 'base.html.twig' %}

{% block title %}Humeurs{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Humeurs</div>
                <h1 class="h2 mb-1">Mood tracking entries</h1>
                <p class="text-muted mb-0">Review and manage recorded mood levels and notes.</p>
            </div>

            <a class="btn btn-primary" href="{{ path('app_humeurs_new') }}">
                <i class="bi bi-plus-lg me-1"></i>Add humeur
            </a>
        </div>

        <div class="card content-card">
            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-3 px-4">
                <div>
                    <h2 class="h5 mb-1">Mood history</h2>
                    <p class="text-muted mb-0">Entries created through the humeurs module.</p>
                </div>
                <span class="badge rounded-pill text-bg-light">{{ humeurs|length }} entries</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Id</th>
                                <th>Level</th>
                                <th>Notes</th>
                                <th>Created at</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for humeur in humeurs %}
                            <tr>
                                <td>{{ humeur.id }}</td>
                                <td>{{ humeur.niveau }}</td>
                                <td>{{ humeur.notes|length > 110 ? humeur.notes|slice(0, 110) ~ '...' : humeur.notes }}</td>
                                <td>{{ humeur.dateCreation ? humeur.dateCreation|date('Y-m-d H:i') : '--' }}</td>
                                <td class="text-nowrap">
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_humeurs_show', {'id': humeur.id}) }}">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_humeurs_edit', {'id': humeur.id}) }}">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>
                                        {{ include('humeurs/_delete_form.html.twig', {
                                            humeur: humeur,
                                            button_class: 'btn btn-sm btn-outline-danger',
                                            button_label: 'Delete',
                                            form_class: 'd-inline-block',
                                            confirm_message: 'Delete this humeur entry?'
                                        }) }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td class="text-center py-4 empty-state" colspan="5">No humeur entries found.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
