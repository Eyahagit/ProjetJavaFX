{% extends 'base.html.twig' %}

{% block title %}Humeur details{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Humeurs</div>
                <h1 class="h2 mb-1">Humeur #{{ humeur.id }}</h1>
                <p class="text-muted mb-0">Detailed view for this mood tracking record.</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('app_humeurs_index') }}">
                    <i class="bi bi-arrow-left me-1"></i>Back to list
                </a>
                <a class="btn btn-primary" href="{{ path('app_humeurs_edit', {'id': humeur.id}) }}">
                    <i class="bi bi-pencil-square me-1"></i>Edit
                </a>
                {{ include('humeurs/_delete_form.html.twig', {
                    humeur: humeur,
                    button_class: 'btn btn-outline-danger',
                    button_label: 'Delete',
                    form_class: 'd-inline-block',
                    confirm_message: 'Delete this humeur entry?'
                }) }}
            </div>
        </div>

        <div class="card content-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table detail-table align-middle mb-0">
                        <tbody>
                            <tr>
                                <th>Id</th>
                                <td>{{ humeur.id }}</td>
                            </tr>
                            <tr>
                                <th>Level</th>
                                <td>{{ humeur.niveau }}</td>
                            </tr>
                            <tr>
                                <th>Notes</th>
                                <td class="text-break">{{ humeur.notes ?: '--' }}</td>
                            </tr>
                            <tr>
                                <th>Created at</th>
                                <td>{{ humeur.dateCreation ? humeur.dateCreation|date('Y-m-d H:i:s') : '--' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
