{% extends 'base.html.twig' %}

{% block title %}Statistics{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row mb-4">
            <div class="col">
                <h1 class="display-6 fw-bold mb-2">Health statistics</h1>
                <p class="text-muted mb-0">Stress evolution over time based on SanteBienEtre tracking data.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h4 mb-1">Stress evolution</h2>
                        <p class="text-muted mb-3">Line chart built from follow-up dates and stress levels.</p>

                        {% if dates is not empty %}
                            <div style="height: 380px;">
                                <canvas id="stressEvolutionChart"></canvas>
                            </div>
                        {% else %}
                            <div class="alert alert-light border mb-0" role="alert">
                                No SanteBienEtre data is available yet.
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h4 mb-3">Tracking data</h2>

                        {% if stats_rows is not empty %}
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Date</th>
                                            <th scope="col">Stress level</th>
                                            <th scope="col">Sleep quality</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in stats_rows %}
                                            <tr>
                                                <td>{{ row.date }}</td>
                                                <td>{{ row.stress_level }}</td>
                                                <td>{{ row.sleep_quality }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="alert alert-light border mb-0" role="alert">
                                No records are available to display.
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if dates is not empty %}
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const chartElement = document.getElementById('stressEvolutionChart');

                if (!chartElement || typeof Chart === 'undefined') {
                    return;
                }

                new Chart(chartElement, {
                    type: 'line',
                    data: {
                        labels: {{ dates|json_encode|raw }},
                        datasets: [{
                            label: 'Stress level',
                            data: {{ stress_levels|json_encode|raw }},
                            borderColor: 'rgba(220, 53, 69, 1)',
                            backgroundColor: 'rgba(220, 53, 69, 0.15)',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }, {
                            label: 'Sleep quality',
                            data: {{ sleep_qualities|json_encode|raw }},
                            borderColor: 'rgba(13, 110, 253, 1)',
                            backgroundColor: 'rgba(13, 110, 253, 0.12)',
                            fill: false,
                            tension: 0.35,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                suggestedMax: 10,
                                ticks: {
                                    stepSize: 1
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: true
                            }
                        }
                    }
                });
            });
        </script>
    {% endif %}
{% endblock %}
