{% extends 'base.html.twig' %}

{% block title %}Health record details{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Sante</div>
                <h1 class="h2 mb-1">Health record #{{ sante_bien_etre.id }}</h1>
                <p class="text-muted mb-0">Detailed view for a tracked health and well-being entry.</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('app_sante_bien_etre_index') }}">
                    <i class="bi bi-arrow-left me-1"></i>Back to list
                </a>
                <a class="btn btn-primary" href="{{ path('app_sante_bien_etre_edit', {'id': sante_bien_etre.id}) }}">
                    <i class="bi bi-pencil-square me-1"></i>Edit
                </a>
                {{ include('sante_bien_etre/_delete_form.html.twig', {
                    sante_bien_etre: sante_bien_etre,
                    button_class: 'btn btn-outline-danger',
                    button_label: 'Delete',
                    form_class: 'd-inline-block',
                    confirm_message: 'Delete this health record?'
                }) }}
            </div>
        </div>

        <div class="card content-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table detail-table align-middle mb-0">
                        <tbody>
                            <tr>
                                <th>Id</th>
                                <td>{{ sante_bien_etre.id }}</td>
                            </tr>
                            <tr>
                                <th>Humeur</th>
                                <td>{{ sante_bien_etre.humeur }}</td>
                            </tr>
                            <tr>
                                <th>Niveau stress</th>
                                <td>{{ sante_bien_etre.niveauStress }}</td>
                            </tr>
                            <tr>
                                <th>Qualite sommeil</th>
                                <td>{{ sante_bien_etre.qualiteSommeil }}</td>
                            </tr>
                            <tr>
                                <th>Nutrition</th>
                                <td>{{ sante_bien_etre.nutrition ?: '--' }}</td>
                            </tr>
                            <tr>
                                <th>Activite physique</th>
                                <td>{{ sante_bien_etre.activitePhysique ?: '--' }}</td>
                            </tr>
                            <tr>
                                <th>Developpement personnel</th>
                                <td>{{ sante_bien_etre.developpementPersonnel ?: '--' }}</td>
                            </tr>
                            <tr>
                                <th>Recommandations</th>
                                <td class="text-break">{{ sante_bien_etre.recommandations ?: '--' }}</td>
                            </tr>
                            <tr>
                                <th>Date suivi</th>
                                <td>{{ sante_bien_etre.dateSuivi ? sante_bien_etre.dateSuivi|date('Y-m-d') : '--' }}</td>
                            </tr>
                            <tr>
                                <th>Date creation</th>
                                <td>{{ sante_bien_etre.dateCreation ? sante_bien_etre.dateCreation|date('Y-m-d H:i:s') : '--' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
