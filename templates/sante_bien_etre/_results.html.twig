<div class="card content-card">
    <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-3 px-4">
        <div>
            <h2 class="h5 mb-1">Filtered health records</h2>
            <p class="text-muted mb-0">Results update live as filters and sorting options change.</p>
        </div>
        <span class="badge rounded-pill text-bg-light">{{ sante_bien_etres|length }} records</span>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Humeur</th>
                        <th>NiveauStress</th>
                        <th>QualiteSommeil</th>
                        <th>Nutrition</th>
                        <th>ActivitePhysique</th>
                        <th>DeveloppementPersonnel</th>
                        <th>Recommandations</th>
                        <th>DateSuivi</th>
                        <th>DateCreation</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for sante_bien_etre in sante_bien_etres %}
                    <tr>
                        <td>{{ sante_bien_etre.id }}</td>
                        <td>{{ sante_bien_etre.humeur }}</td>
                        <td>{{ sante_bien_etre.niveauStress }}</td>
                        <td>{{ sante_bien_etre.qualiteSommeil }}</td>
                        <td>{{ sante_bien_etre.nutrition ?: '--' }}</td>
                        <td>{{ sante_bien_etre.activitePhysique ?: '--' }}</td>
                        <td>{{ sante_bien_etre.developpementPersonnel ?: '--' }}</td>
                        <td>{{ sante_bien_etre.recommandations and sante_bien_etre.recommandations|length > 110 ? sante_bien_etre.recommandations|slice(0, 110) ~ '...' : (sante_bien_etre.recommandations ?: '--') }}</td>
                        <td>{{ sante_bien_etre.dateSuivi ? sante_bien_etre.dateSuivi|date('Y-m-d') : '--' }}</td>
                        <td>{{ sante_bien_etre.dateCreation ? sante_bien_etre.dateCreation|date('Y-m-d H:i') : '--' }}</td>
                        <td class="text-nowrap">
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_sante_bien_etre_show', {'id': sante_bien_etre.id}) }}">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_sante_bien_etre_edit', {'id': sante_bien_etre.id}) }}">
                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                </a>
                                {{ include('sante_bien_etre/_delete_form.html.twig', {
                                    sante_bien_etre: sante_bien_etre,
                                    button_class: 'btn btn-sm btn-outline-danger',
                                    button_label: 'Delete',
                                    form_class: 'd-inline-block',
                                    confirm_message: 'Delete this health record?'
                                }) }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="text-center py-4 empty-state" colspan="11">No records found for the selected filters.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
