<form
    class="{{ form_class|default('d-inline-block') }}"
    method="post"
    action="{{ path('app_sante_bien_etre_delete', {'id': sante_bien_etre.id}) }}"
    onsubmit="return confirm('{{ confirm_message|default('Delete this health record?')|e('js') }}');"
>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sante_bien_etre.id) }}">
    <button class="{{ button_class|default('btn btn-outline-danger') }}">
        <i class="bi bi-{{ button_icon|default('trash') }} me-1"></i>{{ button_label|default('Delete') }}
    </button>
</form>
