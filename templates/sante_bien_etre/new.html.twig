{% extends 'base.html.twig' %}

{% block title %}New health record{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <div class="page-kicker mb-2">Sante</div>
                <h1 class="h2 mb-1">Create a health record</h1>
                <p class="text-muted mb-0">Add a new follow-up entry for stress, sleep quality, and recommendations.</p>
            </div>

            <a class="btn btn-outline-secondary" href="{{ path('app_sante_bien_etre_index') }}">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
        </div>

        <div class="card content-card">
            <div class="card-body p-4">
                {{ include('sante_bien_etre/_form.html.twig', {
                    button_label: 'Create record',
                    button_icon: 'plus-lg',
                    button_class: 'btn btn-primary'
                }) }}
            </div>
        </div>
    </div>
{% endblock %}
