{{ form_start(form, {'attr': {'class': 'crud-form'}}) }}
    {{ form_errors(form) }}

    <div class="row g-3">
        <div class="col-md-6">
            {{ form_row(form.humeur) }}
        </div>
        <div class="col-md-3">
            {{ form_row(form.niveauStress) }}
        </div>
        <div class="col-md-3">
            {{ form_row(form.qualiteSommeil) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.nutrition) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.activitePhysique) }}
        </div>
        <div class="col-12">
            {{ form_row(form.developpementPersonnel) }}
        </div>
        <div class="col-12">
            {{ form_row(form.recommandations) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.dateSuivi) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.dateCreation) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.user) }}
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
        <button class="{{ button_class|default('btn btn-primary') }}">
            <i class="bi bi-{{ button_icon|default('check2-circle') }} me-1"></i>{{ button_label|default('Save') }}
        </button>
    </div>
{{ form_end(form) }}
