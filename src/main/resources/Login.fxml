<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="CENTER"
      style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="services.LoginController">

    <VBox spacing="15" maxWidth="400" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30;">

        <Label text="🌿 GrowMind" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" alignment="CENTER"/>

        <Label text="Connexion" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <TextField fx:id="txtEmail" promptText="Email" style="-fx-padding: 12; -fx-background-radius: 10;"/>

        <PasswordField fx:id="txtMotDePasse" promptText="Mot de passe" style="-fx-padding: 12; -fx-background-radius: 10;"/>

        <Label fx:id="lblMessage" style="-fx-text-fill: red; -fx-font-size: 12px;" />

        <HBox spacing="10" alignment="CENTER">
            <Button text="Se connecter" onAction="#handleConnexion"
                    style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 10;"/>
            <Button text="Quitter" onAction="#handleQuitter"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 10;"/>
        </HBox>

    </VBox>
</VBox>