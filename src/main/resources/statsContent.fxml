<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controllers.StatsController" prefWidth="710.0" spacing="15" style="-fx-padding: 10;">
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 5 0;">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📊 Statistiques" />
        <Button onAction="#handleBack" text="← Retour liste" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 6 16;" />
    </HBox>
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" minHeight="400">
        <content>
            <VBox fx:id="chartsContainer" spacing="25" style="-fx-padding: 15; -fx-background-color: transparent;">
                <!-- Charts injected by controller -->
            </VBox>
        </content>
    </ScrollPane>
</VBox>
