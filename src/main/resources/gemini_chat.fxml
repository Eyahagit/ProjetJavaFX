<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.GeminiController"
      style="-fx-background-color: white;"
      prefWidth="450" prefHeight="700">

    <!-- EN-TÊTE -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 15;">
        <Label text="🤖" style="-fx-font-size: 30px;"/>
        <VBox spacing="2">
            <Label text="Assistant IA GrowMind"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Posez vos questions sur la santé mentale"
                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Nouveau" onAction="#handleNouvelleConversation"
                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;"/>
        <Button text="✕" onAction="#handleFermer"
                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 5 10; -fx-cursor: hand;"/>
    </HBox>

    <!-- ZONE DE CHAT -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F7FA; -fx-background-color: #F5F7FA; -fx-border-color: transparent;">
        <VBox fx:id="chatContainer" spacing="10" style="-fx-padding: 15; -fx-background-color: #F5F7FA;">
            <!-- Les messages seront ajoutés ici -->
        </VBox>
    </ScrollPane>

    <!-- INDICATEUR DE SAISIE -->
    <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 5 15; -fx-background-color: #F5F7FA;">
        <Label fx:id="lblTyping" text="L'assistant réfléchit" visible="false"
               style="-fx-text-fill: #95A5A6; -fx-font-style: italic;"/>
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="20" prefHeight="20"/>
    </HBox>

    <!-- ZONE DE SAISIE -->
    <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
        <TextArea fx:id="txtMessage" promptText="Écrivez votre message..." HBox.hgrow="ALWAYS"
                  style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #E2E8F0; -fx-font-size: 14px;"
                  prefRowCount="2" wrapText="true"/>
        <Button fx:id="btnEnvoyer" text="Envoyer" onAction="#handleEnvoyer"
                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;"/>
    </HBox>

</VBox>