<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.MenuPrincipalController"
            style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2);">

    <!-- BARRE LATÉRALE -->
    <VBox prefWidth="280" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          style="-fx-background-color: rgba(255,255,255,0.95);
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);">

        <!-- EN-TÊTE PROFIL -->
        <VBox spacing="15" alignment="CENTER"
              style="-fx-padding: 40 20 30 20;
                     -fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C);">

            <ImageView fitHeight="80" fitWidth="80">
                <Image url="@/assets/logoGrowmind.png" />
            </ImageView>

            <Label text="GrowMind"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Plateforme de Santé Mentale"
                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);"/>
        </VBox>

        <!-- MENU DE NAVIGATION -->
        <VBox spacing="5" style="-fx-padding: 20 10;">

            <Label text="GESTION"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-padding: 10 0 5 10;"/>

            <!-- Dashboard - CORRIGÉ : suppression des onMouseEntered/Exited -->
            <Button fx:id="btnDashboard" onAction="#openDashboard"
                    style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 12 15; -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="📊" style="-fx-font-size: 18px;"/>
                        <Label text="Tableau de bord" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Gestion Cabinets -->
            <Button fx:id="btnCabinet" onAction="#openGestionCabinet"
                    style="-fx-background-color: #e8f4f8; -fx-background-radius: 10; -fx-padding: 12 15; -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="🏢" style="-fx-font-size: 18px;"/>
                        <Label text="Gestion des Cabinets" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label text="5" style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 2 8; -fx-font-size: 11px;" fx:id="lblCabinetCount"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Gestion Psychologues -->
            <Button fx:id="btnPsychologue" onAction="#openGestionPsychologue"
                    style="-fx-background-color: #fff0e8; -fx-background-radius: 10; -fx-padding: 12 15; -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="🧠" style="-fx-font-size: 18px;"/>
                        <Label text="Gestion des Psychologues" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label text="8" style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 2 8; -fx-font-size: 11px;" fx:id="lblPsychologueCount"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Gestion Rendez-vous -->
            <Button fx:id="btnRendezVous" onAction="#openGestionRendezVous"
                    style="-fx-background-color: #e8f4e8; -fx-background-radius: 10; -fx-padding: 12 15; -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="📅" style="-fx-font-size: 18px;"/>
                        <Label text="Gestion des Rendez-vous" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label text="12" style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 2 8; -fx-font-size: 11px;" fx:id="lblRendezVousCount"/>
                    </HBox>
                </graphic>
            </Button>

            <Separator style="-fx-padding: 20 0 10 0;"/>

            <!-- RAPPORTS -->
            <Label text="RAPPORTS"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-padding: 10 0 5 10;"/>

            <Button fx:id="btnStatistiques" onAction="#openStatistiques"
                    style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 12 15; -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="📈" style="-fx-font-size: 18px;"/>
                        <Label text="Statistiques" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnExport" onAction="#exportDonnees"
                    style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-padding: 12 15; -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="📥" style="-fx-font-size: 18px;"/>
                        <Label text="Export données" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- UTILISATEUR -->
            <VBox style="-fx-padding: 20 10; -fx-background-color: #f8f9fa; -fx-background-radius: 10;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 24px;"/>
                    <VBox>
                        <Label text="Dr. Martin" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label text="Administrateur" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                </HBox>

                <Button text="Déconnexion" onAction="#logout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8; -fx-cursor: hand; -fx-font-size: 12px; -fx-margin: 10 0 0 0;"/>
            </VBox>
        </VBox>
    </VBox>

    <!-- ZONE DE CONTENU PRINCIPAL -->
    <StackPane fx:id="contentArea"
               AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
               AnchorPane.leftAnchor="300" AnchorPane.rightAnchor="20"
               style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <!-- DASHBOARD PAR DÉFAUT -->
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 50;">
            <Label text="Bienvenue sur GrowMind"
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Label text="Plateforme de gestion de cabinet psychologique"
                   style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d;"/>

            <!-- STATISTIQUES RAPIDES -->
            <HBox spacing="30" alignment="CENTER" style="-fx-padding: 40 0;">

                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: #e8f4f8; -fx-background-radius: 15; -fx-padding: 25; -fx-min-width: 180;">
                    <Label text="🏢" style="-fx-font-size: 40px;"/>
                    <Label text="Cabinets" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="dashboardCabinetCount" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: #fff0e8; -fx-background-radius: 15; -fx-padding: 25; -fx-min-width: 180;">
                    <Label text="🧠" style="-fx-font-size: 40px;"/>
                    <Label text="Psychologues" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="dashboardPsychologueCount" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #E667AF;"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: #e8f4e8; -fx-background-radius: 15; -fx-padding: 25; -fx-min-width: 180;">
                    <Label text="📅" style="-fx-font-size: 40px;"/>
                    <Label text="Rendez-vous" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="dashboardRendezVousCount" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;"/>
                </VBox>
            </HBox>

            <!-- ACTIONS RAPIDES -->
            <Label text="Actions rapides" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 20 0 0 0;"/>

            <HBox spacing="20" alignment="CENTER">
                <Button text="➕ Nouveau cabinet" onAction="#openGestionCabinet"
                        style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 20;"/>
                <Button text="➕ Nouveau psychologue" onAction="#openGestionPsychologue"
                        style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 20;"/>
                <Button text="➕ Nouveau rendez-vous" onAction="#openGestionRendezVous"
                        style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 20;"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- BARRE DE STATUT -->
    <HBox style="-fx-background-color: #2c3e50; -fx-padding: 8 20;"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="280" AnchorPane.rightAnchor="0">
        <Label fx:id="statusLabel" text="Prêt - Connecté en tant qu'Administrateur"
               style="-fx-text-fill: white; -fx-font-size: 11px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="dateTimeLabel" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;"/>
    </HBox>
</AnchorPane>