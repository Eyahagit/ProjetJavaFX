<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.controlsfx.control.Rating?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controllers.EvaluationModalController">
    <VBox alignment="CENTER" spacing="15" layoutX="30.0" layoutY="30.0" prefWidth="440.0">
        <Label text="Évaluer la Ressource" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <Label fx:id="lblResourceTitle" text="Titre Ressource" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>

        <VBox alignment="CENTER" spacing="5">
            <Label text="Note" style="-fx-font-weight: bold;"/>
            <Rating fx:id="ratingControl" max="5" rating="0" partialRating="false" updateOnHover="true"/>
            <Label fx:id="lblRatingError" text="Veuillez donner une note" textFill="RED" visible="false"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Commentaire" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="txtCommentaire" prefHeight="100.0" wrapText="true" promptText="Votre avis..." style="-fx-border-color: #dcdcdc; -fx-border-radius: 5;"/>
            <Label fx:id="lblCommentError" text="Le commentaire ne peut pas être vide" textFill="RED" visible="false"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="btnSubmit" text="Soumettre" onAction="#handleSubmit" style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"/>
            <Button fx:id="btnCancel" text="Annuler" onAction="#handleCancel" style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"/>
        </HBox>
    </VBox>
</AnchorPane>
