<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AdminDashboardController">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-padding: 20 40 20 40;">
            <VBox spacing="2">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="GrowMind" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="Mental Health Platform" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <!-- ADMIN INFO WITH FIRST & SECOND NAME -->
            <HBox spacing="20" alignment="CENTER_RIGHT">
                <Label style="-fx-font-size: 16px; -fx-text-fill: white;" text="👑 Admin :" />
                <Label fx:id="adminNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(255,255,255,0.2); -fx-padding: 5 15; -fx-background-radius: 20;"
                       text="Loading..." />
                <Button fx:id="logoutButton" onAction="#handleLogout" text="🚪 Logout"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 5; -fx-padding: 5 15;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox alignment="TOP_CENTER" spacing="25">

                <!-- MAIN DASHBOARD CARD -->
                <VBox maxWidth="1400" spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-border-radius: 20; -fx-border-color: #4A6FA5; -fx-border-width: 2;">

                    <!-- WELCOME SECTION WITH ADMIN NAME -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox>
                            <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="👑 Admin Dashboard" />
                            <Label style="-fx-font-size: 18px; -fx-text-fill: #4A6FA5; -fx-font-weight: bold;"
                                   fx:id="welcomeMessageLabel" text="Welcome, Loading..." />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="dateLabel" style="-fx-font-size: 14px; -fx-text-fill: #666;" text="2026-02-13" />
                    </HBox>

                    <Separator />

                    <!-- ADMIN PROFILE CARD -->
                    <HBox spacing="20" style="-fx-background-color: #f8f9fa; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #4A6FA5; -fx-border-radius: 15; -fx-border-width: 1;">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="👤 Admin Profile" />
                            <HBox spacing="10">
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;" text="Name:" />
                                <Label fx:id="adminFullNameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="-" />
                            </HBox>
                            <HBox spacing="10">
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;" text="Email:" />
                                <Label fx:id="adminEmailLabel" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;" text="-" />
                            </HBox>
                            <HBox spacing="10">
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666;" text="Status:" />
                                <Label fx:id="adminStatusLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="Active" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- =============== STATISTICS CARDS =============== -->
                    <HBox spacing="20" alignment="CENTER">

                        <!-- TOTAL USERS CARD -->
                        <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-background-radius: 15; -fx-padding: 25; -fx-pref-width: 280; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Total Users" />
                            <Label fx:id="totalUsersLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="👥 Registered users" />
                        </VBox>

                        <!-- TOTAL PATIENTS CARD -->
                        <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #5FB49C, #4A6FA5); -fx-background-radius: 15; -fx-padding: 25; -fx-pref-width: 280; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Total Patients" />
                            <Label fx:id="totalPatientsLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                            <HBox spacing="10" alignment="CENTER">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);" text="🟢 Active:" />
                                <Label fx:id="activePatientsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #a5d6a5;" text="0" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);" text="🔴 Inactive:" />
                                <Label fx:id="inactivePatientsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ef9a9a;" text="0" />
                            </HBox>
                        </VBox>

                        <!-- TOTAL DOCTORS CARD -->
                        <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #E667AF, #9B59B6); -fx-background-radius: 15; -fx-padding: 25; -fx-pref-width: 280; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Total Doctors" />
                            <Label fx:id="totalDoctorsLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                            <HBox spacing="10" alignment="CENTER">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);" text="🟢 Active:" />
                                <Label fx:id="activeDoctorsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #a5d6a5;" text="0" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);" text="🔴 Inactive:" />
                                <Label fx:id="inactiveDoctorsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ef9a9a;" text="0" />
                            </HBox>
                        </VBox>

                        <!-- TOTAL ADMINS CARD -->
                        <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #9B59B6, #8E44AD); -fx-background-radius: 15; -fx-padding: 25; -fx-pref-width: 280; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Total Admins" />
                            <Label fx:id="totalAdminsLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                            <HBox spacing="10" alignment="CENTER">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);" text="🟢 Active:" />
                                <Label fx:id="activeAdminsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #a5d6a5;" text="0" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);" text="🔴 Inactive:" />
                                <Label fx:id="inactiveAdminsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ef9a9a;" text="0" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <Separator />

                    <!-- =============== LISTS SECTION =============== -->
                    <HBox spacing="20" alignment="CENTER">

                        <!-- DOCTORS LIST -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f9fa; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #E667AF; -fx-border-radius: 15; -fx-border-width: 1;">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E667AF;" text="👨‍⚕️ Doctors List" />
                            <ListView fx:id="doctorsListView" prefHeight="200" style="-fx-background-radius: 10;">
                                <placeholder>
                                    <Label text="No doctors found" />
                                </placeholder>
                            </ListView>
                        </VBox>

                        <!-- PATIENTS LIST -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f9fa; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #5FB49C; -fx-border-radius: 15; -fx-border-width: 1;">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="🩺 Patients List" />
                            <ListView fx:id="patientsListView" prefHeight="200" style="-fx-background-radius: 10;">
                                <placeholder>
                                    <Label text="No patients found" />
                                </placeholder>
                            </ListView>
                        </VBox>
                    </HBox>

                    <!-- ADMINS LIST (NEW) -->
                    <HBox spacing="20" alignment="CENTER">
                        <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f9fa; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #9B59B6; -fx-border-radius: 15; -fx-border-width: 1;">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #9B59B6;" text="👑 Admins List" />
                            <ListView fx:id="adminsListView" prefHeight="200" style="-fx-background-radius: 10;">
                                <placeholder>
                                    <Label text="No admins found" />
                                </placeholder>
                            </ListView>
                        </VBox>
                    </HBox>

                    <Separator />

                    <!-- =============== QUICK ACTIONS =============== -->
                    <VBox spacing="15">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="⚡ Quick Actions" />
                        <HBox spacing="15" alignment="CENTER">
                            <Button fx:id="addUserBtn" onAction="#handleAddUser"
                                    style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5; -fx-cursor: hand;"
                                    text="➕ Add New User"
                                    prefWidth="200" prefHeight="40"/>
                            <Button fx:id="refreshDataBtn" onAction="#handleRefreshData"
                                    style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5; -fx-cursor: hand;"
                                    text="🔄 Refresh Data"
                                    prefWidth="200" prefHeight="40"/>
                        </HBox>
                    </VBox>

                </VBox>  <!-- ✅ FERMETURE DU VBox PRINCIPAL -->
            </VBox>  <!-- ✅ FERMETURE DU VBox DU SCROLLPANE -->
        </ScrollPane>  <!-- ✅ FERMETURE DU SCROLLPANE -->
    </center>  <!-- ✅ FERMETURE DU CENTER -->

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 20;">
            <Label style="-fx-font-size: 12px; -fx-text-fill: white;" text="© 2026 GrowMind - Mental Health Platform. Admin Dashboard v1.0" />
        </HBox>
    </bottom>
</BorderPane>  <!-- ✅ FERMETURE DU BorderPane -->