<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AjouterRendezVousController"
            style="-fx-background-color: #f4f9ff;">

    <HBox spacing="30" layoutX="30" layoutY="30" AnchorPane.topAnchor="30" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30">

        <!-- PANEL GAUCHE - FORMULAIRE -->
        <VBox spacing="20" prefWidth="400"
              style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

            <Label text="📅 Gestion des Rendez-vous"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 10 0;"/>

            <Separator style="-fx-background-color: #5FB49C; -fx-pref-height: 2;"/>

            <!-- CHAMPS DU FORMULAIRE -->
            <VBox spacing="15">
                <VBox spacing="5">
                    <Label text="Date du rendez-vous *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <DatePicker fx:id="datePicker" promptText="Sélectionner une date"
                                style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Heure *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtHeure" promptText="ex: 14:30"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Statut *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtStatut" promptText="Confirmé, Annulé, Reporté, En attente, Terminé"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Type consultation *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtTypeCons" promptText="Consultation, Suivi, Bilan..."
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="ID Psychologue *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboPsychologue" promptText="Sélectionner un psychologue"
                              style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 8;"
                              prefHeight="42.0"/>
                </VBox>
            </VBox>

            <!-- BOUTONS -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 0 0;">
                <Button text="➕ Ajouter" onAction="#ajouter" prefWidth="100"
                        style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Button text="✏ Modifier" onAction="#modifier" prefWidth="100"
                        style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Button text="🗑 Supprimer" onAction="#supprimer" prefWidth="100"
                        style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
            </HBox>

            <HBox alignment="CENTER" spacing="15">
                <Button text="🧹 Effacer" onAction="#clear" prefWidth="150"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Button text="❌ Annuler" onAction="#annuler" prefWidth="150"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <!-- PANEL DROIT - LISTE AVEC RECHERCHE -->
        <VBox spacing="20" prefWidth="600" HBox.hgrow="ALWAYS">

            <Label text="📋 Liste des Rendez-vous"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- RECHERCHE ET FILTRES -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="🔍" style="-fx-font-size: 18px;"/>
                    <TextField fx:id="txtRecherche" promptText="Rechercher..." HBox.hgrow="ALWAYS"
                               style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #e0e0e0; -fx-padding: 10 15;"/>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Filtrer:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboFiltre" prefWidth="150"
                              style="-fx-background-radius: 20; -fx-border-radius: 20;"/>

                    <Label text="Trier:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboTri" prefWidth="150"
                              style="-fx-background-radius: 20; -fx-border-radius: 20;"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="⟳ Actualiser" onAction="#actualiser"
                            style="-fx-background-radius: 20; -fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
                </HBox>

                <HBox alignment="CENTER_RIGHT">
                    <Label text="Total: " style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <Label fx:id="lblTotal" text="0" style="-fx-font-weight: bold; -fx-text-fill: #5FB49C; -fx-font-size: 16px;"/>
                    <Label text=" rendez-vous" style="-fx-text-fill: #34495e;"/>
                </HBox>
            </VBox>

            <!-- LISTVIEW -->
            <ListView fx:id="listView" prefHeight="450" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 5;"/>
        </VBox>
    </HBox>
</AnchorPane>