<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<?import javafx.scene.layout.Region?>
<AnchorPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.RessourceFXController">


    <!-- HEADER SECTION -->
    <VBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="140.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-background-radius: 0 0 25 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">

        <!-- Top bar with home button and user info -->
        <HBox alignment="CENTER_LEFT" prefWidth="1200.0" style="-fx-padding: 10 20 0 20;">
            <Button fx:id="btnHome" onAction="#handleHome" text="🏠 Accueil"
                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 20;
                           -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 20;"/>

            <Region HBox.hgrow="ALWAYS" />

            <HBox style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 5 20; -fx-background-radius: 30;">
                <Label text="📅" style="-fx-font-size: 14px; -fx-text-fill: white; -fx-padding: 0 5 0 0;"/>
                <Label fx:id="lblDate" style="-fx-text-fill: white; -fx-font-size: 14px;" text="01/03/2026"/>
            </HBox>
        </HBox>

        <!-- Main header content -->
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 0;">
            <VBox spacing="3" alignment="CENTER">
                <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 6, 0.4, 2, 2);" text="GrowMind">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>
                <Label style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-weight: 500;" text="Cultivez votre bien-être mental" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-style: italic; -fx-padding: 5 0 0 0;" text="Plateforme complète de santé mentale et développement personnel" />
            </VBox>
        </HBox>

        <!-- Navigation tabs -->
        <HBox alignment="CENTER" spacing="25" style="-fx-padding: 5 0 10 0;">
            <Label style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 15; -fx-padding: 6 15;" text="📚 Gestion Ressources" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="👥 Utilisateurs" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="🏥 Cabinets" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="💬 Forums" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="🧘 Bien-Être" />
        </HBox>
    </VBox>

    <!-- MAIN CONTENT -->
    <HBox layoutX="30.0" layoutY="160.0" prefHeight="520.0" prefWidth="1140.0" spacing="30">

        <!-- LEFT PANEL - FORM -->
        <VBox fx:id="formPanel" maxHeight="520.0" minHeight="520.0" prefHeight="520.0" prefWidth="380.0" spacing="0" style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(74,111,165,0.15), 20, 0.3, 0, 8); -fx-border-color: #4A6FA5; -fx-border-radius: 20; -fx-border-width: 3;">

            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 12 0;">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📋 Gestion des Ressources" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #5FB49C; -fx-background-color: #f0f9f6; -fx-background-radius: 10; -fx-padding: 4 10; -fx-font-weight: bold;" text="CRUD" />
            </HBox>

            <Separator style="-fx-background-color: #e0e0e0; -fx-padding: 5 0;" />

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="18" style="-fx-padding: 15 4 10 0;">
                    <!-- Form Fields -->
                    <VBox spacing="12">
                        <VBox spacing="4">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="📝 Titre *" />
                            <TextField fx:id="txtTitre" prefHeight="38.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px; -fx-padding: 10;" promptText="Ex: Atelier Méditation" />
                        </VBox>

                        <VBox spacing="4">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="📄 Description *" />
                            <TextArea fx:id="txtDescription" prefHeight="70.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px; -fx-padding: 10;" promptText="Description..." wrapText="true" />
                        </VBox>

                        <HBox spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Type *" />
                                <ComboBox fx:id="comboType" prefHeight="38.0" style="-fx-background-radius: 10; -fx-background-color: #f8fdff;" promptText="Sélectionner" />
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Catégorie *" />
                                <ComboBox fx:id="comboCategory" prefHeight="38.0" style="-fx-background-radius: 10; -fx-background-color: #f8fdff;" promptText="Sélectionner" />
                            </VBox>
                        </HBox>

                        <HBox spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="📅 Date *" />
                                <DatePicker fx:id="datePicker" prefHeight="38.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px;" />
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Auteur *" />
                                <TextField fx:id="txtAuthor" prefHeight="38.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px; -fx-padding: 10;" promptText="Admin" text="Admin" />
                            </VBox>
                        </HBox>

                        <VBox spacing="4">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="🔗 Contenu / Lien" />
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <TextField fx:id="txtLocalisation" prefHeight="38.0" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px; -fx-padding: 10;" promptText="URL ou lieu..." />
                                <Button fx:id="btnUploadImage" onAction="#uploadImageToCloudinary" prefHeight="38.0" prefWidth="80.0" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 10; -fx-cursor: hand;" text="☁️ Upload" />
                            </HBox>
                        </VBox>

                        <VBox spacing="4">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Statut" />
                            <ComboBox fx:id="comboStatus" prefHeight="38.0" style="-fx-background-radius: 10; -fx-background-color: #f8fdff;" promptText="Active" />
                        </VBox>
                    </VBox>

                    <!-- Buttons -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15 0 5 0;">
                        <Button fx:id="btnAjouter" onAction="#ajouterEvenement" prefHeight="44.0" prefWidth="100.0" style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;" text="➕ Ajouter" />
                        <Button fx:id="btnModifier" onAction="#modifierEvenement" prefHeight="44.0" prefWidth="100.0" style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;" text="✏️ Modifier" />
                        <Button fx:id="btnSupprimer" onAction="#supprimerEvenement" prefHeight="44.0" prefWidth="100.0" style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;" text="🗑️ Supprimer" />
                    </HBox>

                    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 5 0 0 0;">
                        <Button fx:id="btnClear" onAction="#clearForm" prefHeight="35.0" prefWidth="320.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand;" text="🧹 Effacer le formulaire" />
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>

        <!-- RIGHT PANEL -->
        <StackPane fx:id="rightPanelStack" prefWidth="730.0" HBox.hgrow="ALWAYS">
            <VBox fx:id="listPanel" spacing="15">
                <!-- Header with search and buttons -->
                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: rgba(255,255,255,0.9); -fx-padding: 15; -fx-background-radius: 15;">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📋 Liste des Ressources" />

                    <Label fx:id="lblCount" style="-fx-font-size: 13px; -fx-text-fill: #5FB49C; -fx-font-weight: bold; -fx-background-color: #f0f9f6; -fx-background-radius: 12; -fx-padding: 5 15; -fx-border-color: #5FB49C; -fx-border-radius: 12; -fx-border-width: 1;" text="0 ressource(s)" />

                    <Region HBox.hgrow="ALWAYS" />

                    <TextField fx:id="searchField" onKeyReleased="#handleSearch" promptText="🔍 Rechercher..." style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 20;" prefWidth="200" />

                    <Button fx:id="btnSwitchToUser" onAction="#switchToUser"
                            text="👤 Vue Utilisateur"
                            style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20;" />
                </HBox>

                <!-- TABLEVIEW -->
                <TableView fx:id="listEvenements" onMouseClicked="#handleListClick" prefHeight="350.0" style="-fx-background-color: white; -fx-border-color: #e0f7fa; -fx-border-radius: 15; -fx-background-radius: 15;">
                    <columns>
                        <TableColumn fx:id="colTitre" text="Titre" prefWidth="180.0" />
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="200.0" />
                        <TableColumn fx:id="colType" text="Type" prefWidth="100.0" />
                        <TableColumn fx:id="colCategory" text="Catégorie" prefWidth="100.0" />
                        <TableColumn fx:id="colDate" text="Date" prefWidth="100.0" />
                        <TableColumn fx:id="colAuthor" text="Auteur" prefWidth="100.0" />
                    </columns>
                </TableView>

                <!-- STATS BAR -->
                <HBox alignment="CENTER" spacing="30" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: #4A6FA5; -fx-border-radius: 15; -fx-border-width: 2;">
                    <VBox alignment="CENTER" spacing="3">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="12" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Événements" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="3">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="85%" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Participation" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="3">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #9B59B6;" text="4.8" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Note" />
                    </VBox>
                    <Button fx:id="btnStat" onAction="#openStats" text="📊 Voir détails" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20;" />
                </HBox>
            </VBox>

            <!-- Stats panel (hidden by default) -->
            <VBox fx:id="statsPanel" prefWidth="730.0" visible="false" managed="false" />
        </StackPane>
    </HBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER" layoutX="0.0" layoutY="720.0" prefHeight="30.0" prefWidth="1200.0" style="-fx-background-color: #2c3e50;">
        <Label style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;" text="© 2024 GrowMind - Gestion des Ressources - Plateforme de Santé Mentale v2.0" />
    </HBox>

</AnchorPane>