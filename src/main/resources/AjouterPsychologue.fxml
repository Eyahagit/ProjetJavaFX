<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="750.0" prefWidth="1300.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AjouterPsychologueController"
            style="-fx-background-color: #f4f9ff;">

    <HBox spacing="30" layoutX="40" layoutY="30" AnchorPane.topAnchor="30" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30">

        <!-- ================= PANEL GAUCHE - FORMULAIRE ================= -->
        <VBox spacing="15" prefWidth="450"
              style="-fx-background-color: white;
                     -fx-background-radius: 20;
                     -fx-padding: 30;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

            <Label text="🧠 Gestion des Psychologues"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

            <Separator style="-fx-background-color: #5FB49C; -fx-pref-height: 2;"/>

            <!-- Identité -->
            <Label text="📋 Identité" style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 14px;"/>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Nom *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtNom" promptText="Nom"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Prénom *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtPrenom" promptText="Prénom"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>
            </HBox>

            <!-- Contact -->
            <Label text="📞 Contact" style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 14px; -fx-padding: 10 0 0 0;"/>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Email *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtEmail" promptText="exemple@email.com"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Téléphone *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtTelephone" promptText="ex: 71234567"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>
            </HBox>

            <!-- Professionnel -->
            <Label text="🎓 Informations professionnelles" style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 14px; -fx-padding: 10 0 0 0;"/>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Spécialité *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtSpecialite" promptText="ex: Psychologue clinicien"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Diplôme *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtDiplome" promptText="ex: Master en psychologie"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>
            </HBox>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Expérience (années) *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtExperience" promptText="ex: 5"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Tarif (DT) *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtTarif" promptText="ex: 80"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                </VBox>
            </HBox>

            <!-- Cabinet -->
            <Label text="🏢 Cabinet" style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 14px; -fx-padding: 10 0 0 0;"/>

            <VBox spacing="5">
                <Label text="ID Cabinet *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                <ComboBox fx:id="comboCabinet" promptText="Sélectionner un cabinet"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 8;"
                          prefHeight="42.0"/>
            </VBox>

            <!-- Boutons -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 0 0;">
                <Button text="➕ Ajouter" onAction="#ajouterPsychologue" prefWidth="100"
                        style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Button text="✏️ Modifier" onAction="#modifierPsychologue" prefWidth="100"
                        style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Button text="🗑️ Supprimer" onAction="#supprimerPsychologue" prefWidth="100"
                        style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
            </HBox>

            <HBox alignment="CENTER" spacing="15">
                <Button text="🧹 Effacer" onAction="#clear" prefWidth="150"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Button text="❌ Annuler" onAction="#annuler" prefWidth="150"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 15; -fx-cursor: hand;"/>
            </HBox>

            <Label text="* Champs obligatoires" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px; -fx-padding: 5 0 0 0;"/>
        </VBox>

        <!-- ================= PANEL DROIT - LISTE AVEC RECHERCHE ================= -->
        <VBox prefWidth="750" spacing="20" HBox.hgrow="ALWAYS">

            <Label text="📋 Liste des Psychologues"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- RECHERCHE ET TRI -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">

                <!-- Barre de recherche -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="🔍" style="-fx-font-size: 18px;"/>
                    <TextField fx:id="txtRecherche"
                               promptText="Rechercher (nom, prénom, spécialité, email...)"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #e0e0e0; -fx-padding: 10 15;"/>
                </HBox>

                <!-- Filtres et tri -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Trier par:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboTri" prefWidth="180"
                              style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 5; -fx-background-color: white;"/>

                    <Label text="Filtrer cabinet:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboFiltreCabinet" prefWidth="150"
                              style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 5; -fx-background-color: white;"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnActualiser" text="⟳ Actualiser" onAction="#actualiser"
                            style="-fx-background-radius: 20; -fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
                </HBox>

                <!-- Compteur -->
                <HBox alignment="CENTER_RIGHT">
                    <Label text="Total: " style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <Label fx:id="lblCount" text="0" style="-fx-font-weight: bold; -fx-text-fill: #5FB49C; -fx-font-size: 16px;"/>
                    <Label text=" psychologue(s)" style="-fx-text-fill: #34495e;"/>
                </HBox>
            </VBox>

            <!-- LISTVIEW AMÉLIORÉ -->
            <ListView fx:id="listPsychologue"
                      prefHeight="400"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 5;"/>
        </VBox>
    </HBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          prefHeight="30"
          style="-fx-background-color: #2c3e50;">
        <Label text="© 2024 GrowMind - Plateforme de Santé Mentale | Version 2.0"
               style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;" />
    </HBox>
</AnchorPane>