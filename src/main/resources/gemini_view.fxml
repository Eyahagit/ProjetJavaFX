<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.GeminiController"
      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15;"
      prefWidth="800" prefHeight="700">

    <!-- EN-TÊTE -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="🤖 Assistant IA GrowMind"
               style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #667eea;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblStatus" text="Prêt" style="-fx-text-fill: #27AE60; -fx-font-weight: bold;"/>
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="25" prefHeight="25"/>
    </HBox>

    <Separator/>

    <!-- CONVERSATION -->
    <Label text="Conversation :" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <ListView fx:id="listConversation" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;">
        <placeholder>
            <Label text="Aucun message" style="-fx-text-fill: #95a5a6;"/>
        </placeholder>
    </ListView>

    <!-- SUJETS PRÉDÉFINIS -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Sujet:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="cmbSujet" prefWidth="200" onAction="#handleSujetSelectionne"/>
        <Label text="ou posez votre question ci-dessous" style="-fx-text-fill: #718096;"/>
    </HBox>

    <!-- ZONE DE QUESTION -->
    <TextArea fx:id="txtQuestion" prefRowCount="3" wrapText="true"
              promptText="Ex: Comment gérer l'anxiété au quotidien ?"
              style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3;"/>

    <!-- BOUTONS D'ACTION -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="btnEffacer" text="🗑️ Effacer conversation" onAction="#handleEffacer"
                style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button fx:id="btnEnvoyer" text="✨ Obtenir une réponse" onAction="#handleEnvoyer"
                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-padding: 10 30; -fx-cursor: hand;"/>
    </HBox>

    <!-- ZONE DE RÉPONSE -->
    <Label text="Dernière réponse :" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <TextArea fx:id="txtReponse" prefRowCount="6" wrapText="true" editable="false"
              style="-fx-background-color: #f0f9f6; -fx-background-radius: 10; -fx-border-color: #A5D6A5;
                     -fx-border-width: 1; -fx-border-radius: 10; -fx-font-size: 14px;"/>

    <!-- BOUTON FERMER -->
    <HBox alignment="CENTER_RIGHT">
        <Button text="Fermer" onAction="#handleFermer"
                style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>

</VBox>