<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.PatientDashboardController">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #5FB49C, #4A6FA5); -fx-padding: 20 40 20 40;">
            <VBox spacing="2">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="GrowMind" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="Mental Health Platform" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <!-- PATIENT INFO WITH NAME -->
            <!-- Ajoutez ce bouton à côté des autres boutons -->
            <Button fx:id="homeButton" onAction="#handleHome"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 5; -fx-padding: 5 15;"
                    text="🏠 Accueil" />
            <HBox spacing="20" alignment="CENTER_RIGHT">
                <Label style="-fx-font-size: 16px; -fx-text-fill: white;" text="🩺 Patient :" />
                <Label fx:id="patientNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(255,255,255,0.2); -fx-padding: 5 15; -fx-background-radius: 20;"
                       text="Loading..." />
                <Button fx:id="logoutButton" onAction="#handleLogout" text="🚪 Logout"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 5; -fx-padding: 5 15;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox alignment="TOP_CENTER" spacing="25">

                <!-- MAIN DASHBOARD CARD -->
                <VBox maxWidth="1200" spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-border-radius: 20; -fx-border-color: #5FB49C; -fx-border-width: 2;">

                    <!-- WELCOME SECTION -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox>
                            <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🩺 Patient Dashboard" />
                            <Label style="-fx-font-size: 18px; -fx-text-fill: #5FB49C; -fx-font-weight: bold;"
                                   fx:id="welcomeLabel" text="Welcome, Loading..." />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="dateLabel" style="-fx-font-size: 14px; -fx-text-fill: #666;" text="2026-02-14" />
                    </HBox>

                    <Separator />

                    <!-- =============== PATIENT PROFILE CARD =============== -->
                    <HBox spacing="20" style="-fx-background-color: #f8f9fa; -fx-background-radius: 15; -fx-padding: 25; -fx-border-color: #5FB49C; -fx-border-radius: 15; -fx-border-width: 2;">
                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="👤 Patient Information" />

                            <GridPane hgap="20" vgap="10">
                                <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>

                                <!-- Row 0 -->
                                <Label text="Full Name:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="fullNameLabel" style="-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <!-- Row 1 -->
                                <Label text="Email:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="emailLabel" style="-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <!-- Row 2 -->
                                <Label text="Age:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Label fx:id="ageLabel" style="-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <!-- Row 3 -->
                                <Label text="Gender:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Label fx:id="genderLabel" style="-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <!-- Row 4 -->
                                <Label text="Phone:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <Label fx:id="phoneLabel" style="-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                                <!-- Row 5 -->
                                <Label text="Birth Date:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                <Label fx:id="birthDateLabel" style="-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                            </GridPane>
                        </VBox>
                    </HBox>

                    <!-- =============== MEDICAL INFORMATION CARDS =============== -->
                    <HBox spacing="20" alignment="CENTER">

                        <!-- BLOOD TYPE CARD -->
                        <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #5FB49C, #4A6FA5); -fx-background-radius: 15; -fx-padding: 25; -fx-pref-width: 280; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Blood Type" />
                            <Label fx:id="bloodTypeLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="-" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="🩸 Your blood group" />
                        </VBox>

                        <!-- WEIGHT CARD -->
                        <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-background-radius: 15; -fx-padding: 25; -fx-pref-width: 280; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Weight" />
                            <Label fx:id="weightLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="-" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="⚖️ Current weight" />
                        </VBox>

                        <!-- HEIGHT CARD -->
                        <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #E667AF, #9B59B6); -fx-background-radius: 15; -fx-padding: 25; -fx-pref-width: 280; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Height" />
                            <Label fx:id="heightLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="-" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="📏 Your height" />
                        </VBox>
                    </HBox>

                    <Separator />

                    <!-- =============== DOCTORS LIST =============== -->
                    <VBox spacing="20">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="👨‍⚕️ Available Doctors" />

                        <ListView fx:id="doctorsListView" prefHeight="200" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;">
                            <placeholder>
                                <Label text="No doctors available" style="-fx-text-fill: #666;" />
                            </placeholder>
                        </ListView>
                    </VBox>
                    <!-- Quick Actions -->
                    <VBox spacing="10">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E667AF;" text="⚡ Quick Actions" />

                        <HBox spacing="15" alignment="CENTER">
                            <Button fx:id="refreshBtn" onAction="#handleRefresh"
                                    style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5;"
                                    text="🔄 Refresh" />

                            <Button fx:id="editProfileBtn" onAction="#handleEditProfile"
                                    style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5;"
                                    text="✏️ Edit Profile" />
                        </HBox>
                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 20;">
            <Label style="-fx-font-size: 12px; -fx-text-fill: white;" text="© 2026 GrowMind - Mental Health Platform. Patient Dashboard v1.0" />
        </HBox>
    </bottom>
</BorderPane>