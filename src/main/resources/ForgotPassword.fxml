<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2);"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ForgotPasswordController">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox alignment="CENTER" spacing="30" style="-fx-padding: 40;">

                <!-- Carte principale -->
                <VBox maxWidth="500" spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">

                    <!-- En-tête -->
                    <VBox alignment="CENTER" spacing="10">
                        <Label style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="🔐" />
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="Mot de passe oublié ?" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-text-alignment: center;"
                               text="Ne vous inquiétez pas, nous vous aiderons à le réinitialiser." />
                    </VBox>

                    <Separator />

                    <!-- ÉTAPE 1 : Email -->
                    <VBox fx:id="step1Box" spacing="20">
                        <VBox spacing="5">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📧 Adresse email" />
                            <TextField fx:id="emailField" promptText="exemple@email.com"
                                       style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />
                        </VBox>

                        <Button fx:id="sendCodeBtn" onAction="#handleSendCode"
                                style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📨 Envoyer le code"
                                prefHeight="45" maxWidth="Infinity"/>
                    </VBox>

                    <!-- ÉTAPE 2 : Code de vérification -->
                    <VBox fx:id="step2Box" spacing="20" visible="false" managed="false">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="📱 Étape 2 : Vérification" />

                        <VBox spacing="5">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Code de vérification" />
                            <TextField fx:id="codeField" promptText="Entrez le code à 6 chiffres"
                                       style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"
                                       maxWidth="Infinity"/>
                        </VBox>

                        <HBox spacing="10">
                            <Button fx:id="verifyCodeBtn" onAction="#handleVerifyCode"
                                    style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"
                                    text="✅ Vérifier"
                                    HBox.hgrow="ALWAYS" prefHeight="45"/>

                            <Button onAction="#handleResendCode"
                                    style="-fx-background-color: transparent; -fx-border-color: #5FB49C; -fx-border-radius: 8; -fx-text-fill: #5FB49C; -fx-font-weight: bold; -fx-padding: 12; -fx-cursor: hand;"
                                    text="🔄 Renvoyer"
                                    HBox.hgrow="ALWAYS" prefHeight="45"/>
                        </HBox>

                        <Label fx:id="timerLabel" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-alignment: center;" />
                    </VBox>

                    <!-- ÉTAPE 3 : Nouveau mot de passe -->
                    <VBox fx:id="step3Box" spacing="20" visible="false" managed="false">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="🔑 Étape 3 : Nouveau mot de passe" />

                        <VBox spacing="5">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Nouveau mot de passe" />
                            <PasswordField fx:id="newPasswordField" promptText="Minimum 6 caractères"
                                           style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Confirmer le mot de passe" />
                            <PasswordField fx:id="confirmPasswordField" promptText="Retapez votre mot de passe"
                                           style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />
                        </VBox>

                        <Button fx:id="resetPasswordBtn" onAction="#handleResetPassword"
                                style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🔄 Réinitialiser"
                                prefHeight="45" maxWidth="Infinity"/>
                    </VBox>

                    <!-- Indicateur de chargement -->
                    <ProgressIndicator fx:id="loadingIndicator" maxWidth="50" maxHeight="50" visible="false" />

                    <!-- Message de statut -->
                    <Label fx:id="statusLabel" style="-fx-text-fill: #666; -fx-alignment: center; -fx-wrap-text: true;" />

                    <Separator />

                    <!-- Lien retour -->
                    <HBox alignment="CENTER">
                        <Button fx:id="backToLoginBtn" onAction="#handleBackToLogin"
                                style="-fx-background-color: transparent; -fx-text-fill: #4A6FA5; -fx-font-weight: bold; -fx-underline: true; -fx-cursor: hand;"
                                text="← Retour à la connexion" />
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>