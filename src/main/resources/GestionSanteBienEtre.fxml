<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.GestionSanteBienEtreController"
            fitToWidth="true" fitToHeight="true"
            style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="25" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-padding: 20;">

        <!-- ==================== HEADER MODERNE ==================== -->
        <VBox spacing="15" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-background-radius: 25; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0.3, 0, 5);">

            <!-- Top Bar with Logo and Buttons -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <ImageView fx:id="logoImageView" fitHeight="50" preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, rgba(255,255,255,0.3), 10, 0.3, 0, 2);" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- User Info Badge -->
                <HBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 5 15; -fx-background-radius: 30;">
                    <Label fx:id="lblUserWelcome" text="Bienvenue, Utilisateur !" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblUserRole" text="👤 Patient" style="-fx-background-color: #FBBF24; -fx-padding: 3 12; -fx-background-radius: 20; -fx-text-fill: #1A202C; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                </HBox>
            </HBox>

            <!-- Separator -->
            <Separator style="-fx-background-color: rgba(255,255,255,0.2);" />

            <!-- Title and Action Buttons -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5">
                    <Label text="🌿 Gestion Santé et Bien-être"
                           style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0.3, 1, 1);"/>
                    <Label text="Suivez et améliorez votre bien-être quotidien"
                           style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-style: italic;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Quick Action Buttons -->
                <HBox spacing="10">
                    <Button text="🤖 Dashboard IA" onAction="#handleOpenAIDashboard"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 25;"/>
                    <Button text="🧠 Bien-être" onAction="#handleOpenWellness"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 25;"/>
                    <Button text="🌙 Sommeil" onAction="#handleOpenSommeil"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 25;"/>
                    <Button text="chatbot AI" onAction="#handleOpenChatbot"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 25;"/>

                    <!-- Ajoutez ce bouton dans l'en-tête, à côté des autres boutons -->
                    <Button fx:id="btnHome" onAction="#handleHome" text="🏠 Accueil"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 25;"/>

                </HBox>
            </HBox>
        </VBox>

        <!-- ==================== FORMULAIRE ET RECOMMANDATIONS ==================== -->
        <HBox spacing="20">
            <!-- Formulaire d'évaluation -->
            <VBox spacing="15" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📝" style="-fx-font-size: 24px;"/>
                    <Label text="Nouvelle évaluation" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Santé" style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-padding: 3 12; -fx-background-radius: 20; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>

                <Separator style="-fx-background-color: #e0e0e0;" />

                <GridPane hgap="20" vgap="15" style="-fx-padding: 10 0;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="ID Utilisateur :" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="tfUserId" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa; -fx-padding: 8 15;"/>

                    <Label text="Date :" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <DatePicker fx:id="dpDateSuivi" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa; -fx-padding: 5;"/>

                    <Label text="Humeur :" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="cbHumeur" GridPane.rowIndex="2" GridPane.columnIndex="1"
                              promptText="Sélectionner votre humeur"
                              style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa; -fx-padding: 5;"/>

                    <Label text="Stress (1-10) :" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <Spinner fx:id="spNiveauStress" GridPane.rowIndex="3" GridPane.columnIndex="1"
                             editable="true" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa;"/>

                    <Label text="Sommeil (1-10) :" GridPane.rowIndex="4" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <Spinner fx:id="spQualiteSommeil" GridPane.rowIndex="4" GridPane.columnIndex="1"
                             editable="true" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa;"/>

                    <Label text="Nutrition :" GridPane.rowIndex="5" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="tfNutrition" GridPane.rowIndex="5" GridPane.columnIndex="1"
                               promptText="Alimentation récente"
                               style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa; -fx-padding: 8 15;"/>

                    <Label text="Activité :" GridPane.rowIndex="6" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="tfActivite" GridPane.rowIndex="6" GridPane.columnIndex="1"
                               promptText="Activité physique"
                               style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa; -fx-padding: 8 15;"/>

                    <Label text="Développement :" GridPane.rowIndex="7" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="tfDeveloppement" GridPane.rowIndex="7" GridPane.columnIndex="1"
                               promptText="Développement personnel"
                               style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa; -fx-padding: 8 15;"/>
                </GridPane>

                <!-- Boutons d'action -->
                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15 0 5 0;">
                    <Button fx:id="btnAjouter" text="➕ Ajouter" onAction="#handleAdd"
                            style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-min-width: 100;"/>
                    <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#handleUpdate"
                            style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-min-width: 100;"/>
                    <Button fx:id="btnSupprimer" text="🗑️ Supprimer" onAction="#handleDelete"
                            style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-min-width: 100;"/>
                    <Button fx:id="btnEffacer" text="🔄 Effacer" onAction="#handleClear"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-min-width: 100;"/>
                </HBox>
            </VBox>

            <!-- Recommandations -->
            <VBox spacing="15" prefWidth="350"
                  style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="💡" style="-fx-font-size: 24px;"/>
                    <Label text="Recommandations" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="IA" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 3 12; -fx-background-radius: 20; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>

                <Separator style="-fx-background-color: #e0e0e0;" />

                <TextArea fx:id="taRecommandations" editable="false" wrapText="true"
                          style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0; -fx-background-color: #f8f9fa; -fx-font-size: 13px; -fx-padding: 15;"/>

                <Label text="✨ Ces recommandations sont générées automatiquement en fonction de vos données"
                       style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-wrap-text: true;"/>
            </VBox>
        </HBox>

        <!-- ==================== TABLEAU ET FILTRES ==================== -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📊" style="-fx-font-size: 24px;"/>
                <Label text="Historique des évaluations" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="lblCount" text="0 enregistrement(s)"
                       style="-fx-background-color: #e3f2fd; -fx-text-fill: #4A6FA5; -fx-padding: 3 15; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 12px;"/>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Filtres par date -->
                <HBox spacing="10" alignment="CENTER">
                    <Label text="Du:" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                    <DatePicker fx:id="dpDateDebut" promptText="Date début" prefWidth="120"
                                style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #e0e0e0;"/>
                    <Label text="Au:" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                    <DatePicker fx:id="dpDateFin" promptText="Date fin" prefWidth="120"
                                style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #e0e0e0;"/>
                    <Button text="🔍 Filtrer" onAction="#handleFilter"
                            style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand;"/>
                    <Button text="📋 Tout afficher" onAction="#handleShowAll"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand;"/>
                </HBox>
            </HBox>

            <Separator style="-fx-background-color: #e0e0e0;" />

            <TableView fx:id="tableView" prefHeight="250"
                       style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                    <TableColumn fx:id="colUserId" text="User" prefWidth="50"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="80"/>
                    <TableColumn fx:id="colHumeur" text="Humeur" prefWidth="80"/>
                    <TableColumn fx:id="colStress" text="Stress" prefWidth="60"/>
                    <TableColumn fx:id="colSommeil" text="Sommeil" prefWidth="70"/>
                    <TableColumn fx:id="colNutrition" text="Nutrition" prefWidth="100"/>
                    <TableColumn fx:id="colActivite" text="Activité" prefWidth="100"/>
                    <TableColumn fx:id="colDeveloppement" text="Développement" prefWidth="120"/>
                    <TableColumn fx:id="colRecommandations" text="Recommandations" prefWidth="150"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 5 0 0 0;">
                <CheckBox fx:id="chkShowAll" text="Mode admin - voir tous les utilisateurs"
                          style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Pagination fx:id="pagination" pageCount="1" prefHeight="35"
                            style="-fx-background-color: #f8f9fa; -fx-background-radius: 20; -fx-padding: 3;"/>
            </HBox>
        </VBox>

        <!-- ==================== GRAPHIQUE ==================== -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📈" style="-fx-font-size: 24px;"/>
                <Label text="Évolution du niveau de stress" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </HBox>

            <Separator style="-fx-background-color: #e0e0e0;" />

            <LineChart fx:id="lineChartStress" prefHeight="200" createSymbols="true"
                       style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0; -fx-padding: 10;">
                <xAxis>
                    <CategoryAxis label="Date" style="-fx-tick-label-fill: #666;"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Niveau (1-10)" lowerBound="0" upperBound="10" tickUnit="1"
                                style="-fx-tick-label-fill: #666;"/>
                </yAxis>
            </LineChart>
        </VBox>

        <!-- ==================== FOOTER ==================== -->
        <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"
                   text="© 2024 GrowMind - Gestion Santé et Bien-être - Plateforme de Santé Mentale" />
        </HBox>
    </VBox>
</ScrollPane>