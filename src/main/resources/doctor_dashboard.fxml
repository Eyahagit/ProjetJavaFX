<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: linear-gradient(135deg, #B5B5BA, #7572C0);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DoctorDashboardController">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #E667AF, #9B59B6); -fx-padding: 20 40;">
            <VBox spacing="2">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="GrowMind" />
                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);" text="Mental Health Platform" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Label style="-fx-font-size: 14px; -fx-text-fill: white;" text="👨‍⚕️" />
                <Label fx:id="doctorNameLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" text="Doctor" />
                <Button fx:id="logoutButton" onAction="#handleLogout" text="Logout" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5; -fx-padding: 5 15;" />
            </HBox>
        </HBox>
    </top>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
            <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20;">

                <!-- Main Card -->
                <VBox maxWidth="1000" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                    <!-- Welcome Section -->
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Doctor Dashboard" />
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 16px; -fx-text-fill: #E667AF;" text="Welcome, Loading..." />
                        <Label fx:id="dateLabel" style="-fx-font-size: 12px; -fx-text-fill: #666;" text="2026-02-14" />
                    </VBox>

                    <Separator />

                    <!-- Doctor Profile Card -->
                    <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E667AF;" text="👤 Doctor Information" />

                        <GridPane hgap="20" vgap="10">
                            <padding><Insets left="10"/></padding>

                            <Label text="Full Name:" style="-fx-font-weight: bold;-fx-text-fill: #090979;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="fullNameLabel" style="-fx-font-weight: bold;-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Email:" style="-fx-font-weight: bold; -fx-text-fill: #090979;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="emailLabel" text="-" style="-fx-font-weight: bold;-fx-text-fill: #2c3e50;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Specialty:" style="-fx-font-weight: bold; -fx-text-fill: #090979;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="specialtyLabel" text="-" style="-fx-font-weight: bold;-fx-text-fill: #2c3e50;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Experience:" style="-fx-font-weight: bold; -fx-text-fill: #090979;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="experienceLabel" style="-fx-font-weight: bold;-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Diploma:" style="-fx-font-weight: bold; -fx-text-fill: #090979;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <Label fx:id="diplomaLabel" style="-fx-font-weight: bold;-fx-text-fill: #2c3e50;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                            <Label text="Status:" style="-fx-font-weight: bold; -fx-text-fill: #090979;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <Label fx:id="statusLabel" style="-fx-font-weight: bold;-fx-text-fill: #2c3e50;" text="Active" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        </GridPane>
                    </VBox>

                    <Separator />

                    <!-- Statistics Cards -->
                    <HBox spacing="15" alignment="CENTER">

                        <VBox spacing="5" style="-fx-background-color: linear-gradient(to right, #E667AF, #9B59B6); -fx-padding: 20; -fx-background-radius: 10; -fx-pref-width: 200;">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: white;" text="Total Patients" />
                            <Label fx:id="totalPatientsLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                        </VBox>

                        <VBox spacing="5" style="-fx-background-color: linear-gradient(to right, #5FB49C, #4A6FA5); -fx-padding: 20; -fx-background-radius: 10; -fx-pref-width: 200;">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: white;" text="Active Patients" />
                            <Label fx:id="activePatientsLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                        </VBox>

                        <VBox spacing="5" style="-fx-background-color: linear-gradient(to right, #9B59B6, #8E44AD); -fx-padding: 20; -fx-background-radius: 10; -fx-pref-width: 200;">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: white;" text="Consultations" />
                            <Label fx:id="consultationsLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                        </VBox>
                        <VBox spacing="5" style="-fx-background-color: linear-gradient(to right, #9B59B6, #8E44AD); -fx-padding: 20; -fx-background-radius: 10; -fx-pref-width: 200;">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: white;" text="Trif " />
                            <Label fx:id="TarifLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                        </VBox>
                    </HBox>

                    <Separator />

                    <!-- Patients List -->
                    <VBox spacing="10">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E667AF;" text="📋 My Patients List" />

                        <ListView fx:id="patientsListView" prefHeight="200">
                            <placeholder>
                                <Label text="No patients assigned yet" />
                            </placeholder>
                        </ListView>
                    </VBox>

                    <Separator />

                    <!-- Quick Actions -->
                    <VBox spacing="10">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E667AF;" text="⚡ Quick Actions" />

                        <HBox spacing="15" alignment="CENTER">
                            <Button fx:id="refreshBtn" onAction="#handleRefresh"
                                    style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5;"
                                    text="🔄 Refresh" />

                            <Button fx:id="editProfileBtn" onAction="#handleEditProfile"
                                    style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5;"
                                    text="✏️ Edit Profile" />
                        </HBox>
                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>