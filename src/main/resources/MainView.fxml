<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="services.EvenementFXController">

    <!-- Background decorative elements -->
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#9B59B6" height="120.0" layoutX="-50.0" layoutY="0.0" opacity="0.15" rotate="45.0" width="300.0" />
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#E667AF" height="150.0" layoutX="1100.0" layoutY="650.0" opacity="0.15" rotate="-30.0" width="200.0" />
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#F1C40F" height="100.0" layoutX="900.0" layoutY="-30.0" opacity="0.1" rotate="15.0" width="250.0" />

    <!-- HEADER SECTION - LOGO SEULEMENT À DROITE -->
    <VBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="140.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-background-radius: 0 0 25 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">

        <!-- LOGO GRAND à droite -->
        <HBox alignment="CENTER_RIGHT" prefWidth="1200.0" prefHeight="100.0">
            <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@/assets/logoGrowmind.png" />
            </ImageView>
        </HBox>

        <Label style="-fx-font-size: 15px; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-style: italic; -fx-padding: 8 0 0 0;" text="Plateforme complète de santé mentale et développement personnel" />

        <!-- Navigation tabs -->
        <HBox alignment="CENTER" spacing="25" style="-fx-padding: 12 0 0 0;">
            <Label style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 15; -fx-padding: 6 15;" text="🎯 Événements" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="👥 Utilisateurs" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="🏥 Cabinets" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="💬 Forums" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="🧘 Bien-Être" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="📚 Formation" />
        </HBox>
    </VBox>

    <!-- MAIN CONTENT -->
    <HBox layoutX="30.0" layoutY="170.0" prefHeight="530.0" prefWidth="1140.0" spacing="30">

        <!-- LEFT PANEL - FORM -->
        <VBox prefWidth="420.0" spacing="25" style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(74,111,165,0.15), 20, 0.3, 0, 8); -fx-border-color: #4A6FA5; -fx-border-radius: 20; -fx-border-width: 3;">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🎪 Gestion des Événements" />
                <Label style="-fx-font-size: 12px; -fx-text-fill: #5FB49C; -fx-background-color: #f0f9f6; -fx-background-radius: 10; -fx-padding: 4 10; -fx-font-weight: bold;" text="CRUD Complet" />
            </HBox>

            <!-- Form Fields -->
            <VBox spacing="15">
                <!-- Titre -->
                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="📝 Titre de l'événement *" />
                    <TextField fx:id="txtTitre" prefHeight="42.0" prefWidth="360.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 14px; -fx-padding: 12;" promptText="Ex: Atelier de Méditation Mindfulness" />
                </VBox>

                <!-- Description -->
                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="📄 Description *" />
                    <TextArea fx:id="txtDescription" prefHeight="110.0" prefWidth="360.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 14px; -fx-padding: 12;" promptText="Description détaillée de l'événement..." wrapText="true" />
                </VBox>

                <!-- Date et Localisation Row -->
                <HBox spacing="20">
                    <VBox spacing="5" prefWidth="180">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="📅 Date *" />
                        <DatePicker fx:id="datePicker" prefHeight="42.0" prefWidth="180.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 14px;" />
                    </VBox>

                    <VBox spacing="5" prefWidth="180">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="📍 Localisation *" />
                        <TextField fx:id="txtLocalisation" prefHeight="42.0" prefWidth="180.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 14px; -fx-padding: 12;" promptText="Ex: Salle Zen, Zoom, Cabinet..." />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 25 0 0 0;">
                <Button fx:id="btnAjouter" onAction="#ajouterEvenement" onMouseEntered="#hoverAjouter" onMouseExited="#exitAjouter" prefHeight="48.0" prefWidth="120.0" style="-fx-background-color: linear-gradient(to right, #5FB49C, #4AA189); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="➕ Ajouter" />

                <Button fx:id="btnModifier" onAction="#modifierEvenement" onMouseEntered="#hoverModifier" onMouseExited="#exitModifier" prefHeight="48.0" prefWidth="120.0" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #3A5F8A); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="✏️ Modifier" />

                <Button fx:id="btnSupprimer" onAction="#supprimerEvenement" onMouseEntered="#hoverSupprimer" onMouseExited="#exitSupprimer" prefHeight="48.0" prefWidth="120.0" style="-fx-background-color: linear-gradient(to right, #E667AF, #D3549C); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="🗑️ Supprimer" />
            </HBox>

            <!-- Quick Stats -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
                <VBox alignment="CENTER" spacing="3">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="⚡" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Interface Rapide" />
                </VBox>
                <VBox alignment="CENTER" spacing="3">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #9B59B6;" text="🔒" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Sécurisé" />
                </VBox>
                <VBox alignment="CENTER" spacing="3">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F1C40F;" text="📊" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Analytics" />
                </VBox>
            </HBox>
        </VBox>

        <!-- RIGHT PANEL - LISTVIEW -->
        <VBox prefWidth="710.0" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📋 Liste des Événements" />
                <Label fx:id="lblCount" style="-fx-font-size: 14px; -fx-text-fill: #5FB49C; -fx-font-weight: bold; -fx-background-color: #f0f9f6; -fx-background-radius: 12; -fx-padding: 6 15; -fx-border-color: #5FB49C; -fx-border-radius: 12; -fx-border-width: 2;" text="0 événement(s)" />

                <!-- Search Box -->
                <TextField promptText="🔍 Rechercher un événement..." style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: white; -fx-font-size: 13px; -fx-padding: 8 12; -fx-pref-width: 200;" />
            </HBox>

            <!-- LISTVIEW -->
            <ListView fx:id="listEvenements" onMouseClicked="#handleListClick" prefHeight="380.0" prefWidth="710.0" style="-fx-background-color: white; -fx-border-color: #e0f7fa; -fx-border-radius: 15; -fx-background-radius: 15;" />

            <!-- STATS BAR -->
            <HBox alignment="CENTER" spacing="40" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #4A6FA5; -fx-border-radius: 15; -fx-border-width: 2;">
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="12" />
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #4A6FA5;" text="🎯" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Événements/Mois" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="85%" />
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #5FB49C;" text="📈" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Participation" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #9B59B6;" text="4.8" />
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #9B59B6;" text="⭐" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Satisfaction" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F1C40F;" text="98%" />
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #F1C40F;" text="🚀" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Taux de Réussite" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER" layoutX="0.0" layoutY="720.0" prefHeight="30.0" prefWidth="1200.0" style="-fx-background-color: #2c3e50;">
        <Label style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;" text="© 2024 GrowMind - Plateforme de Santé Mentale  et Développement Personnel | Version 2.0 | Tous droits réservés" />
    </HBox>

    <!-- Floating Action Button -->
    <Button layoutX="1120.0" layoutY="650.0" prefWidth="50.0" prefHeight="50.0" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 50;" text="➕" />
</AnchorPane>