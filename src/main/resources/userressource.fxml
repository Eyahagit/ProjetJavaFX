<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.UserRessourceController">

    <!-- Background decorative elements -->
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#9B59B6" height="120.0" layoutX="-50.0" layoutY="0.0" opacity="0.1" rotate="45.0" width="300.0" />
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#E667AF" height="150.0" layoutX="1100.0" layoutY="650.0" opacity="0.1" rotate="-30.0" width="200.0" />
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#F1C40F" height="100.0" layoutX="900.0" layoutY="-30.0" opacity="0.08" rotate="15.0" width="250.0" />

    <!-- ==================== HEADER SECTION ==================== -->
    <VBox layoutX="0.0" layoutY="0.0" prefHeight="180.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-background-radius: 0 0 30 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0.5, 0, 5);">

        <!-- Top Bar -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1200.0" style="-fx-padding: 15 30 10 30;">
            <!-- Left side with home button -->
            <Button fx:id="btnHome" onAction="#handleHome" text="🏠 Accueil"
                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 25; -fx-cursor: hand; -fx-padding: 8 25;
                           -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 25;"/>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Right side with date and user -->
            <HBox spacing="20" alignment="CENTER_RIGHT">
                <!-- Date -->
                <HBox style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 5 15; -fx-background-radius: 20;">
                    <Label text="📅" style="-fx-font-size: 14px; -fx-text-fill: white; -fx-padding: 0 5 0 0;"/>
                    <Label fx:id="lblDate" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                </HBox>

                <!-- User Info -->
                <HBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 5 20; -fx-background-radius: 30;">
                    <Label fx:id="lblUserWelcome" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblUserRole" style="-fx-background-color: #FBBF24; -fx-padding: 3 12; -fx-background-radius: 20; -fx-text-fill: #1A202C; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                </HBox>
            </HBox>
        </HBox>

        <!-- Separator -->
        <Separator style="-fx-background-color: rgba(255,255,255,0.2);" />

        <!-- Brand Section -->
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="1200.0" style="-fx-padding: 10 30;">
            <!-- Logo and App Name -->
            <HBox spacing="15" alignment="CENTER">
                <Label text="📚" style="-fx-font-size: 48px; -fx-effect: dropshadow(gaussian, white, 10, 0.3, 0, 0);" />
                <VBox>
                    <Label text="GrowMind" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label text="Responsabilité et Bibliothèque" fx:id="lblGestionTitle" style="-fx-font-size: 16px; -fx-text-fill: #FBBF24; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Slogan -->
            <Label text="Cultivez votre bien-être mental" style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-style: italic;"/>
        </HBox>
    </VBox>

    <!-- ==================== FILTERS SECTION ==================== -->
    <VBox layoutY="190.0" prefWidth="1200.0" spacing="15" style="-fx-padding: 0 30;">

        <!-- Title and Stats -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="📚 Catalogue Ressources" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #212158;"/>
            <HBox style="-fx-background-color: #e6d5ad; -fx-padding: 5 20; -fx-background-radius: 30;">
                <Label fx:id="lblStats" text="0 ressources" style="-fx-text-fill: #1A202C; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox style="-fx-background-color: rgba(255,255,255,0.1); -fx-padding: 5 15; -fx-background-radius: 20;">
                <Label text="Total:" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 0 5 0 0;"/>
                <Label fx:id="lblTotalCount" text="0" style="-fx-text-fill: #FBBF24; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </HBox>
        </HBox>

        <!-- Search and Filters -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="🔍 Rechercher une ressource..." prefWidth="300"
                       style="-fx-background-radius: 25; -fx-padding: 10 15; -fx-background-color: white; -fx-border-radius: 25;"/>

            <ComboBox fx:id="filterType" prefWidth="140" promptText="Type"
                      style="-fx-background-radius: 25; -fx-background-color: white;"/>

            <ComboBox fx:id="filterCategory" prefWidth="140" promptText="Catégorie"
                      style="-fx-background-radius: 25; -fx-background-color: white;"/>

            <Button text="🔄 Rafraîchir" onAction="#refreshList"
                    style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand;"/>
            <Button text="Ressource" onAction="#handleGoToRessource"
                    style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand;"/>
            </HBox>
    </VBox>

    <!-- ==================== CONTENT SECTION ==================== -->
    <ScrollPane fitToWidth="true" layoutY="290.0" prefHeight="400.0" prefWidth="1200.0"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
        <content>
            <FlowPane fx:id="cardsContainer" hgap="25" vgap="25"
                      style="-fx-background-color: transparent; -fx-padding: 20 30;">
                <!-- Cards will be injected here -->
            </FlowPane>
        </content>
    </ScrollPane>

    <!-- ==================== FOOTER ==================== -->
    <HBox alignment="CENTER" layoutX="0.0" layoutY="720.0" prefHeight="30.0" prefWidth="1200.0"
          style="-fx-background-color: #2c3e50;">
        <Label style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;"
               text="© 2024 GrowMind • Responsabilité et Bibliothèque • Plateforme de Santé Mentale v2.0" />
    </HBox>

</AnchorPane>