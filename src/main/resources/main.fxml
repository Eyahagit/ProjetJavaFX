<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controllers.RessourceFXController">

    <!-- Background decorative elements -->
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#9B59B6" height="120.0" layoutX="-50.0" layoutY="0.0" opacity="0.15" rotate="45.0" width="300.0" />
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#E667AF" height="150.0" layoutX="1100.0" layoutY="650.0" opacity="0.15" rotate="-30.0" width="200.0" />
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#F1C40F" height="100.0" layoutX="900.0" layoutY="-30.0" opacity="0.1" rotate="15.0" width="250.0" />

    <!-- HEADER SECTION -->
    <VBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="140.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-background-radius: 0 0 25 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">
        <HBox alignment="CENTER" spacing="20">
            <!-- LOGO - Retiré ImageView pour test -->
            <VBox spacing="3">
                <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 6, 0.4, 2, 2);" text="GrowMind">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>
                <Label style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-weight: 500;" text="Cultivez votre bien-être mental" />
            </VBox>
        </HBox>

        <Label style="-fx-font-size: 15px; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-style: italic; -fx-padding: 8 0 0 0;" text="Plateforme complète de santé mentale et développement personnel" />

        <!-- Navigation tabs -->
        <HBox alignment="CENTER" spacing="25" style="-fx-padding: 12 0 0 0;">
            <Label style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 15; -fx-padding: 6 15;" text="🎯 Événements" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="👥 Utilisateurs" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="🏥 Cabinets" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="💬 Forums" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="🧘 Bien-Être" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);" text="📚 Formation" />
        </HBox>
    </VBox>

    <!-- MAIN CONTENT -->
    <HBox layoutX="30.0" layoutY="170.0" prefHeight="480.0" prefWidth="1140.0" spacing="30">

        <!-- LEFT PANEL - FORM (fixed height, scroll inside) -->
        <VBox fx:id="formPanel" maxHeight="480.0" minHeight="480.0" prefHeight="480.0" prefWidth="380.0" spacing="0" style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(74,111,165,0.15), 20, 0.3, 0, 8); -fx-border-color: #4A6FA5; -fx-border-radius: 20; -fx-border-width: 3;">

            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 12 0;">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🎪 Gestion des Ressources" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #5FB49C; -fx-background-color: #f0f9f6; -fx-background-radius: 10; -fx-padding: 4 10; -fx-font-weight: bold;" text="CRUD" />
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                <VBox spacing="18" style="-fx-padding: 0 4 10 0;">
                    <!-- Form Fields -->
                    <VBox spacing="12">
                        <VBox spacing="4">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="📝 Titre *" />
                            <TextField fx:id="txtTitre" prefHeight="38.0" prefWidth="340.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px; -fx-padding: 10;" promptText="Ex: Atelier Méditation" />
                        </VBox>
                        <VBox spacing="4">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="📄 Description *" />
                            <TextArea fx:id="txtDescription" prefHeight="70.0" prefWidth="340.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px; -fx-padding: 10;" promptText="Description..." wrapText="true" />
                        </VBox>
                        <HBox spacing="12">
                            <VBox spacing="4" prefWidth="165">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Type *" />
                                <ComboBox fx:id="comboType" prefHeight="38.0" prefWidth="165.0" style="-fx-background-radius: 10; -fx-background-color: #f8fdff;" promptText="formation, article..." />
                            </VBox>
                            <VBox spacing="4" prefWidth="165">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Catégorie *" />
                                <ComboBox fx:id="comboCategory" prefHeight="38.0" prefWidth="165.0" style="-fx-background-radius: 10; -fx-background-color: #f8fdff;" promptText="santé, bien-être..." />
                            </VBox>
                        </HBox>
                            <HBox spacing="12">
                            <VBox spacing="4" prefWidth="165">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="📅 Date *" />
                                <DatePicker fx:id="datePicker" prefHeight="38.0" prefWidth="165.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px;" />
                            </VBox>
                            <VBox spacing="4" prefWidth="165">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Contenu / Lien" />
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtLocalisation" prefHeight="38.0" prefWidth="120.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px; -fx-padding: 10;" promptText="Lien, lieu..." />
                                    <Button fx:id="btnUploadImage" onAction="#uploadImageToCloudinary" prefHeight="38.0" prefWidth="90.0" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 10; -fx-cursor: hand;" text="☁️ Upload" />
                                </HBox>
                            </VBox>
                        </HBox>
                        <HBox spacing="12">
                            <VBox spacing="4" prefWidth="165">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Auteur *" />
                                <TextField fx:id="txtAuthor" prefHeight="38.0" prefWidth="165.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: #f8fdff; -fx-font-size: 13px; -fx-padding: 10;" promptText="Admin..." />
                            </VBox>
                            <VBox spacing="4" prefWidth="165">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5; -fx-font-size: 12px;" text="Statut" />
                                <ComboBox fx:id="comboStatus" prefHeight="38.0" prefWidth="165.0" style="-fx-background-radius: 10; -fx-background-color: #f8fdff;" promptText="Active, Draft..." />
                            </VBox>
                        </HBox>
                    </VBox>
                    <!-- Buttons -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 8 0 0 0;">
                        <Button fx:id="btnAjouter" onAction="#ajouterEvenement" onMouseEntered="#hoverAjouter" onMouseExited="#exitAjouter" prefHeight="44.0" prefWidth="110.0" style="-fx-background-color: linear-gradient(to right, #5FB49C, #4AA189); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="➕ Ajouter" />
                        <Button fx:id="btnModifier" onAction="#modifierEvenement" onMouseEntered="#hoverModifier" onMouseExited="#exitModifier" prefHeight="44.0" prefWidth="110.0" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #3A5F8A); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="✏️ Modifier" />
                        <Button fx:id="btnSupprimer" onAction="#supprimerEvenement" onMouseEntered="#hoverSupprimer" onMouseExited="#exitSupprimer" prefHeight="44.0" prefWidth="110.0" style="-fx-background-color: linear-gradient(to right, #E667AF, #D3549C); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="🗑️ Supprimer" />
                    </HBox>
                    <!-- Quick Stats (compact) -->
                    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 8 0 0 0;">
                        <VBox alignment="CENTER" spacing="2">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: #4A6FA5;" text="⚡" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" text="Rapide" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: #9B59B6;" text="🔒" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" text="Sécurisé" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: #F1C40F;" text="📊" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" text="Analytics" />
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>

        <!-- RIGHT PANEL - Stack: List view OR Stats view -->
        <StackPane fx:id="rightPanelStack" prefWidth="710.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <VBox fx:id="listPanel" prefWidth="710.0" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📋 Liste des Ressources" />

                <Label fx:id="lblCount" style="-fx-font-size: 14px; -fx-text-fill: #5FB49C; -fx-font-weight: bold; -fx-background-color: #f0f9f6; -fx-background-radius: 12; -fx-padding: 6 15; -fx-border-color: #5FB49C; -fx-border-radius: 12; -fx-border-width: 2;" text="0 ressource(s)" />


                <!-- Search Box -->
                <TextField fx:id="searchField" onKeyReleased="#handleSearch" promptText="🔍 Rechercher un événement..." style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d1e7f3; -fx-background-color: white; -fx-font-size: 13px; -fx-padding: 8 12; -fx-pref-width: 200;" />
                <Button fx:id="btnStat" onAction="#openStats" text="Stat" style="-fx-background-color: #9B59B6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 20; -fx-font-size: 14px;" />
                <!-- Switch to User view -->
                <Button fx:id="btnSwitchToUser" onAction="#switchToUser"
                        text="👤 Vue Utilisateur"
                        style="-fx-background-color: linear-gradient(to right,#667eea,#764ba2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 20; -fx-font-size: 14px;" />
            </HBox>

            <!-- TABLEVIEW -->
            <TableView fx:id="listEvenements" onMouseClicked="#handleListClick" prefHeight="380.0" prefWidth="710.0" style="-fx-background-color: white; -fx-border-color: #e0f7fa; -fx-border-radius: 15; -fx-background-radius: 15;">
                <columns>
                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="150.0" />
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="150.0" />
                    <TableColumn fx:id="colType" text="Type" prefWidth="100.0" />
                    <TableColumn fx:id="colCategory" text="Catégorie" prefWidth="100.0" />
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100.0" />
                    <TableColumn fx:id="colAuthor" text="Auteur" prefWidth="100.0" />
                </columns>
            </TableView>

            <!-- STATS BAR -->
            <HBox alignment="CENTER" spacing="40" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #4A6FA5; -fx-border-radius: 15; -fx-border-width: 2;">
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="12" />
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #4A6FA5;" text="🎯" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Événements/Mois" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="85%" />
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #5FB49C;" text="📈" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Participation" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #9B59B6;" text="4.8" />
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #9B59B6;" text="⭐" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Satisfaction" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="8">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F1C40F;" text="98%" />
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #F1C40F;" text="🚀" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="Taux de Réussite" />
                </VBox>
            </HBox>
            </VBox>
            <!-- Stats panel (loaded when Stat is clicked) -->
            <VBox fx:id="statsPanel" prefWidth="710.0" visible="false" managed="false" />
        </StackPane>
    </HBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER" layoutX="0.0" layoutY="720.0" prefHeight="30.0" prefWidth="1200.0" style="-fx-background-color: #2c3e50;">
        <Label style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;" text="©️ 2024 GrowMind - Plateforme de Santé Mentale  et Développement Personnel | Version 2.0 | Tous droits réservés" />
    </HBox>

    <!-- Floating Action Button -->
</AnchorPane>
