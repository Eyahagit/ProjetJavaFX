<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.LoginController">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #4A6FA5, #5FB49C); -fx-padding: 20 40 20 40;">
            <VBox spacing="2">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="GrowMind" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" text="Mental Health Platform" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-font-size: 16px; -fx-text-fill: white;" text="👤 Login" />
        </HBox>
    </top>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox alignment="CENTER" spacing="30">
                <VBox maxWidth="600" spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-border-radius: 20; -fx-border-color: #4A6FA5; -fx-border-width: 2;">

                    <!-- TITLE -->
                    <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🔐 Welcome Back" />
                    <Label style="-fx-font-size: 16px; -fx-text-fill: #666;" text="Sign in to your account" />

                    <!-- SEPARATOR -->
                    <Separator />

                    <!-- ================= LOGIN FORM ================= -->
                    <VBox spacing="20">

                        <!-- EMAIL FIELD -->
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="Email" />
                            <TextField fx:id="emailField" promptText="Enter your email" style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-border-width: 1;">
                                <VBox.margin>
                                    <Insets bottom="5" />
                                </VBox.margin>
                            </TextField>
                        </VBox>

                        <!-- PASSWORD FIELD -->
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="Password" />
                            <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-border-width: 1;">
                                <VBox.margin>
                                    <Insets bottom="5" />
                                </VBox.margin>
                            </PasswordField>
                        </VBox>

                        <!-- REMEMBER ME & FORGOT PASSWORD -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <CheckBox fx:id="rememberCheckBox" text="Remember me"  style="-fx-text-fill: #4A6FA5; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: transparent;"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Hyperlink fx:id="forgotPasswordLink" text="Forgot Password?" style="-fx-text-fill: #5FB49C; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: transparent;" />
                        </HBox>

                        <!-- SEPARATOR -->
                        <Separator />

                        <!-- LOGIN BUTTON -->
                        <Button fx:id="loginButton" onAction="#handleLogin" text="Log_in"
                                style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-padding: 15 30 15 30; -fx-background-radius: 10;"
                                prefWidth="400" prefHeight="50"
                                defaultButton="true">
                            <VBox.margin>
                                <Insets top="10" />
                            </VBox.margin>
                        </Button>

                        <!-- SIGN UP LINK -->
                        <HBox alignment="CENTER" spacing="5">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="Don't have an account?" />
                            <Hyperlink fx:id="signUpLink" onAction="#goToSignUp" text="Sign Up" style="-fx-text-fill: #4A6FA5; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: transparent;" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 20;">
            <Label style="-fx-font-size: 12px; -fx-text-fill: white;" text="© 2026 GrowMind - Mental Health Platform. All rights reserved." />
        </HBox>
    </bottom>
</BorderPane>