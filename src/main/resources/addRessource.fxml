<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="613.0" prefWidth="540.0" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controllers.AddRessourceController">
    <VBox alignment="CENTER" layoutX="50.0" layoutY="50.0" prefHeight="500.0" prefWidth="400.0" spacing="20" style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Ajouter une Ressource" />

        <VBox spacing="10">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="Titre" />
            <TextField fx:id="titreField" promptText="Titre de la ressource" style="-fx-background-radius: 10; -fx-padding: 10;" />
        </VBox>

        <VBox spacing="10">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="Description" />
            <TextArea fx:id="descriptionArea" prefHeight="100.0" promptText="Description..." style="-fx-background-radius: 10;" wrapText="true" />
        </VBox>

        <HBox spacing="15">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="Type" />
                <ComboBox fx:id="typeComboBox" prefWidth="180.0" style="-fx-background-radius: 10;" />
            </VBox>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="Catégorie" />
                <ComboBox fx:id="categorieComboBox" prefWidth="180.0" style="-fx-background-radius: 10;" />
            </VBox>
        </HBox>

        <VBox spacing="10">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="Localisation / Lien" />
            <TextField fx:id="localisationField" promptText="Lien ou Lieu (Optionnel)" style="-fx-background-radius: 10; -fx-padding: 10;" />
        </VBox>

        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="btnSauvegarder" onAction="#handleSauvegarder" style="-fx-background-color: #5FB49C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20;" text="Sauvegarder" />
            <Button fx:id="btnAnnuler" onAction="#handleAnnuler" style="-fx-background-color: #E667AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20;" text="Annuler" />
        </HBox>

    </VBox>
</AnchorPane>