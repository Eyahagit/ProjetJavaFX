<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2);"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ProfileController"
            prefHeight="650.0" prefWidth="500.0">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox alignment="CENTER" spacing="25" style="-fx-padding: 30;">

                <!-- Carte principale -->
                <VBox maxWidth="450" spacing="20" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">

                    <!-- En-tête avec titre dynamique -->
                    <VBox alignment="CENTER" spacing="10">
                        <Label fx:id="profileTitleLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="👤 Mon Profil" />
                        <Separator />
                    </VBox>

                    <!-- ===== INFORMATIONS COMMUNES ===== -->
                    <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4A6FA5;" text="📋 Informations générales" />

                        <GridPane hgap="10" vgap="10">
                            <Label text="Nom complet:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="fullNameLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Email:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="emailLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Rôle:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="roleLabel" text="-" style="-fx-text-fill: #5FB49C; -fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Âge:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                            <Label fx:id="ageLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                            <Label text="Genre:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                            <Label fx:id="genderLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                            <Label text="Téléphone:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                            <Label fx:id="phoneLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                            <Label text="Date naiss.:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                            <Label fx:id="birthDateLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="6" GridPane.columnIndex="1" />

                            <Label text="Statut:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                            <Label fx:id="statusLabel" text="🟢 Actif" style="-fx-text-fill: #2e7d32; -fx-font-weight: bold;" GridPane.rowIndex="7" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- ===== CHAMPS SPÉCIFIQUES PATIENT ===== -->
                    <VBox fx:id="patientFields" spacing="15" style="-fx-background-color: #f0f9ff; -fx-background-radius: 10; -fx-padding: 20;" visible="false" managed="false">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5FB49C;" text="🩺 Informations médicales" />

                        <GridPane hgap="10" vgap="10">
                            <Label text="Groupe sanguin:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="bloodTypeLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Poids:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="weightLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Taille:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="heightLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- ===== CHAMPS SPÉCIFIQUES DOCTEUR ===== -->
                    <VBox fx:id="doctorFields" spacing="15" style="-fx-background-color: #fff0f5; -fx-background-radius: 10; -fx-padding: 20;" visible="false" managed="false">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #E667AF;" text="👨‍⚕️ Informations professionnelles" />

                        <GridPane hgap="10" vgap="10">
                            <Label text="Spécialité:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="specialtyLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Expérience:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="experienceLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Diplôme:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="diplomaLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Tarif:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                            <Label fx:id="priceLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                            <Label text="Disponibilité:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                            <Label fx:id="availabilityLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                            <Label text="Statut:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                            <Label fx:id="doctorStatusLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- ===== CHAMPS SPÉCIFIQUES ADMIN ===== -->
                    <VBox fx:id="adminFields" spacing="15" style="-fx-background-color: #f3e8ff; -fx-background-radius: 10; -fx-padding: 20;" visible="false" managed="false">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #9B59B6;" text="👑 Informations administrateur" />

                        <GridPane hgap="10" vgap="10">
                            <Label text="Statut admin:" style="-fx-font-weight: bold; -fx-text-fill: #666;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="adminStatusLabel" text="-" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- Bouton fermer -->
                    <HBox alignment="CENTER">
                        <Button fx:id="closeButton" onAction="#handleClose"
                                style="-fx-background-color: #4A6FA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 30; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Fermer"
                                prefWidth="150" prefHeight="35" />
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>